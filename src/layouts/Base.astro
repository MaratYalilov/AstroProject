---
import "../styles/tailwind.css";
import qcfFontLoaderSource from "../utils/qcfFontLoader.js?raw";
import NavBar from "@/components/NavBar";
import GlossaryOverlay from "@/components/glossary/GlossaryOverlay";
import ScrollToTop from "../components/ScrollToTop";
import OpenGraphImage from "../components/OpenGraphImage.astro";

// One self-contained implementation for both early HTML and module callers.
const qcfFontBootstrap = `(() => {${qcfFontLoaderSource.replace('export function initQcfFonts', 'function initQcfFonts')}
initQcfFonts();})();`;

interface Props {
  title?: string;
  description?: string;
  readingPage?: boolean;
  ogImage?: string;
  ogImageAlt?: string;
  ogTitle?: string;
  ogSubtitle?: string;
  ogSubject?: string;
}

const { title = "Lesson", description, readingPage = false, ogImage, ogImageAlt, ogTitle = title, ogSubtitle, ogSubject } = Astro.props;
---

<html lang="ru" class="bg-background text-foreground">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico?v=3" />
    <!-- Тема из localStorage -->
    <script is:inline>
      (function () {
        try {
          var ls = null;
          try { ls = localStorage.getItem('theme'); } catch (e) {}
          var dark = ls !== 'light';
          if (dark) document.documentElement.classList.add('dark');
          document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
          document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
        } catch (e) {}
      })();
    </script>

    <script is:inline data-qcf-bootstrap set:html={qcfFontBootstrap} />

    <!-- Диаграммы Mermaid: клик по схеме открывает попап с зумом -->
    <script>
      import { initMermaidModal } from "../utils/mermaidModal";
      import { initQuranWaslHints } from "../utils/quranWaslHints";

      initMermaidModal();
      initQuranWaslHints();
    </script>

    <!-- Quran audio: плейлисты + кастомная кнопка play/pause -->
    <script is:inline>
      (function () {
        if (typeof window === 'undefined') return;

        // --- Плейлисты (для диапазонов аятов) ---
        function parsePlaylist(raw) {
          if (!raw) return [];
          try {
            var parsed = JSON.parse(raw);
            if (Array.isArray(parsed)) {
              return parsed.filter(function (item) {
                return typeof item === 'string' && item.trim().length > 0;
              });
            }
          } catch (err) {
            // ignore, fallback below
          }
          return raw
            .split('|')
            .map(function (s) { return s.trim(); })
            .filter(function (s) { return s.length > 0; });
        }

        function enhanceAudio(audio) {
          var tracks = parsePlaylist(audio.getAttribute('data-playlist') || '');
          if (!tracks.length) return;

          var index = 0;

          function setTrack(nextIndex, autoplay) {
            index = nextIndex;
            audio.src = tracks[index];
            audio.currentTime = 0;
            audio.load();
            if (autoplay) {
              requestQuranPlayback(audio);
            }
          }

          setTrack(0, false);

          audio.addEventListener('ended', function () {
            if (index < tracks.length - 1) {
              // продолжаем следующий аят
              setTrack(index + 1, true);
            } else {
              // плейлист закончился - сбрасываемся в начало и шлём кастомное событие
              setTrack(0, false);

              var ev;
              try {
                ev = new CustomEvent('quran-playlist-finished');
              } catch (e) {
                ev = document.createEvent('CustomEvent');
                ev.initCustomEvent('quran-playlist-finished', false, false, {});
              }
              audio.dispatchEvent(ev);
            }
          });
        }

        // --- Кастомная кнопка "квадрат с треугольником" для аятов ---
        var currentQuranAudio = null;
        var currentQuranButton = null;
        var quranAudioClickDelegated = false;
        var quranAudioRequest = 0;
        var quranAudioTitles = new WeakMap();
        var pendingQuranButton = null;
        var pendingQuranStyle = null;
        var pendingQuranStatus = null;

        function queueQuranAudioButton(button) {
          pendingQuranButton = button;
          // Keep feedback outside the React-owned HTML while it is still hydrating.
          if (!pendingQuranStyle) {
            pendingQuranStyle = document.createElement('style');
            document.head.appendChild(pendingQuranStyle);
            pendingQuranStatus = document.createElement('span');
            pendingQuranStatus.className = 'sr-only';
            pendingQuranStatus.setAttribute('role', 'status');
            document.body.appendChild(pendingQuranStatus);
          }
          var id = CSS.escape(button.getAttribute('data-audio-id') || '');
          pendingQuranStyle.textContent = '.quran-audio-button[data-audio-id="' + id + '"] .quran-audio-button__icon::after{display:block}';
          pendingQuranStatus.textContent = 'Аудио загружается';
        }

        function clearPendingQuranButton() {
          pendingQuranButton = null;
          if (pendingQuranStyle) pendingQuranStyle.textContent = '';
          if (pendingQuranStatus) pendingQuranStatus.textContent = '';
        }

        // Keep server-rendered lesson HTML intact until React has adopted it.
        function canEnhanceQuranElement(element) {
          return !element.closest('[data-quran-audio-ready="false"]');
        }

        function resetQuranAudioState(audio) {
          if (currentQuranAudio !== audio) return;

          quranAudioRequest++;
          currentQuranAudio = null;
          if (currentQuranButton) {
            currentQuranButton.removeAttribute('data-state');
            currentQuranButton.removeAttribute('aria-busy');
            var title = quranAudioTitles.get(currentQuranButton);
            if (title != null) currentQuranButton.setAttribute('title', title);
            currentQuranButton = null;
          }
        }

        function setQuranAudioState(audio, state) {
          if (currentQuranAudio !== audio || !currentQuranButton) return;
          var button = currentQuranButton;
          if (!quranAudioTitles.has(button)) {
            quranAudioTitles.set(button, button.getAttribute('title') || 'слушать');
          }
          button.setAttribute('data-state', state);
          if (state === 'loading') {
            button.setAttribute('aria-busy', 'true');
            button.setAttribute('title', 'Аудио загружается');
          } else {
            button.removeAttribute('aria-busy');
            button.setAttribute('title', quranAudioTitles.get(button));
          }
        }

        function requestQuranPlayback(audio) {
          var request = ++quranAudioRequest;
          var button = currentQuranButton;
          setQuranAudioState(audio, 'loading');
          function failed() {
            if (request !== quranAudioRequest || currentQuranAudio !== audio) return;
            resetQuranAudioState(audio);
            if (button) button.setAttribute('title', 'Не удалось загрузить аудио. Нажмите, чтобы повторить.');
          }
          try {
            var promise = audio.play();
            if (promise && typeof promise.then === 'function') {
              promise.then(function () {
                if (request === quranAudioRequest) setQuranAudioState(audio, 'playing');
              }, failed);
            }
          } catch (error) {
            failed();
          }
        }

        function setupQuranAudioEvents(audio) {
          if (audio.getAttribute('data-quran-audio-events-initialized') === 'true') return;
          audio.setAttribute('data-quran-audio-events-initialized', 'true');
          audio.addEventListener('playing', function () {
            setQuranAudioState(audio, 'playing');
          });
          audio.addEventListener('waiting', function () {
            if (!audio.paused) setQuranAudioState(audio, 'loading');
          });
          audio.addEventListener('stalled', function () {
            if (!audio.paused && audio.readyState < 3) setQuranAudioState(audio, 'loading');
          });
          audio.addEventListener('pause', function () {
            // Changing a playlist source also queues pause; the next track may already be playing.
            if (audio.paused && !audio.ended) resetQuranAudioState(audio);
          });
          audio.addEventListener('error', function () {
            var button = currentQuranAudio === audio ? currentQuranButton : null;
            resetQuranAudioState(audio);
            if (button) button.setAttribute('title', 'Не удалось загрузить аудио. Нажмите, чтобы повторить.');
          });
          audio.addEventListener('ended', function () {
            if (!audio.hasAttribute('data-playlist')) resetQuranAudioState(audio);
          });
          audio.addEventListener('quran-playlist-finished', function () {
            resetQuranAudioState(audio);
          });
        }

        function handleQuranAudioButtonClick(button) {
          var block = button.closest('[data-quran-ayah]');
          if (!block) return;
          if (!canEnhanceQuranElement(block)) {
            queueQuranAudioButton(button);
            return;
          }
          clearPendingQuranButton();

          var audioId = button.getAttribute('data-audio-id');
          var audio = block.querySelector('audio.quran-audio-element') ||
            (audioId ? document.getElementById(audioId) : null);

          if (!audio || !audio.classList || !audio.classList.contains('quran-audio-element')) {
            return;
          }

          if (audio.hasAttribute('data-playlist') && audio.getAttribute('data-playlist-initialized') !== 'true') {
            audio.setAttribute('data-playlist-initialized', 'true');
            enhanceAudio(audio);
          }

          setupQuranAudioEvents(audio);

          // A repeated tap during loading must not start another play request.
          if (currentQuranAudio === audio && button.getAttribute('data-state') === 'loading') return;

          if (currentQuranAudio && currentQuranAudio !== audio) {
            var previous = currentQuranAudio;
            resetQuranAudioState(previous);
            previous.pause();
            previous.currentTime = 0;
          }

          if (audio.paused) {
            if (audio.error) audio.load();
            currentQuranAudio = audio;
            currentQuranButton = button;
            requestQuranPlayback(audio);
          } else {
            audio.pause();
            resetQuranAudioState(audio);
          }
        }

        function setupDelegatedQuranAudioClick() {
          if (quranAudioClickDelegated) return;
          quranAudioClickDelegated = true;

          document.addEventListener('click', function (event) {
            var target = event.target;
            if (!target || !target.closest) return;

            var button = target.closest('.quran-audio-button');
            if (!button) return;

            event.preventDefault();
            handleQuranAudioButtonClick(button);
          });
        }

        function setupQuranAudioButtons() {
          var blocks = document.querySelectorAll('[data-quran-ayah]');
          blocks.forEach(function (block) {
            if (!canEnhanceQuranElement(block)) return;
            var button = block.querySelector('.quran-audio-button');
            var audio = block.querySelector('audio.quran-audio-element');
            if (!button || !audio) return;

            if (button.getAttribute('data-quran-audio-initialized') === 'true') {
              return;
            }
            button.setAttribute('data-quran-audio-initialized', 'true');
            setupQuranAudioEvents(audio);
          });
        }

        // --- Инициализация всего, что связано с Quran-аудио ---
        function initAll() {
          setupDelegatedQuranAudioClick();

          // Подготовить плейлисты (audio[data-playlist])
          document.querySelectorAll('audio[data-playlist]').forEach(function (audio) {
            if (!canEnhanceQuranElement(audio)) return;
            if (audio.getAttribute('data-playlist-initialized') === 'true') {
              return;
            }
            audio.setAttribute('data-playlist-initialized', 'true');
            enhanceAudio(audio);
          });

          // Настроить кастомные кнопки "play/pause"
          setupQuranAudioButtons();

          if (pendingQuranButton && !pendingQuranButton.isConnected) clearPendingQuranButton();
          if (pendingQuranButton && canEnhanceQuranElement(pendingQuranButton)) {
            var button = pendingQuranButton;
            clearPendingQuranButton();
            handleQuranAudioButtonClick(button);
          }
        }

        document.addEventListener('astro:page-load', initAll);
        document.addEventListener('quran:reinit', initAll);

        // Delegation is ready before deferred lesson modules finish downloading.
        setupDelegatedQuranAudioClick();
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAll);
        } else {
          initAll();
        }
      })();
    </script>

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <meta property="og:title" content={ogTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:site_name" content="HUTBA" />
    <OpenGraphImage title={ogTitle} subtitle={ogSubtitle} subject={ogSubject} image={ogImage} alt={ogImageAlt} />
    {readingPage && <script is:inline>
      (function () {
        if (window.__hutbaLessonFeedbackLink) return;
        window.__hutbaLessonFeedbackLink = true;
        // Restore only after an explicit return from the feedback form.
        try {
          var saved = JSON.parse(sessionStorage.getItem('hutba.feedbackReturn') || 'null');
          if (saved && saved.restore && saved.url === window.location.href) {
            sessionStorage.removeItem('hutba.feedbackReturn');
            var age = Date.now() - saved.time;
            if (age >= 0 && age < 30 * 60 * 1000 && Number.isFinite(saved.y) && saved.y >= 0 && Number.isFinite(saved.x) && saved.x >= 0) {
              var controller = new AbortController();
              var cancelled = false;
              function cancelRestore() { cancelled = true; controller.abort(); }
              function restorePosition() {
                if (!cancelled) window.scrollTo({left: saved.x, top: saved.y, behavior: 'instant'});
              }
              ['wheel', 'touchstart', 'pointerdown', 'keydown'].forEach(function (type) {
                window.addEventListener(type, cancelRestore, {once: true, passive: true, signal: controller.signal});
              });
              document.addEventListener('DOMContentLoaded', function () {
                requestAnimationFrame(restorePosition);
              }, {once: true, signal: controller.signal});
              window.addEventListener('load', function () {
                restorePosition();
                controller.abort();
              }, {once: true, signal: controller.signal});
            }
          }
        } catch (e) {}
        document.addEventListener('click', function (event) {
          var link = event.target instanceof Element ? event.target.closest('a[data-lesson-feedback]') : null;
          if (!link) return;
          var url = new URL('/feedback/bug', window.location.origin);
          url.searchParams.set('url', window.location.href);
          url.searchParams.set('title', link.getAttribute('data-lesson-title') || document.title);
          link.href = url.href;
          if (event.button === 0 && !event.ctrlKey && !event.metaKey && !event.shiftKey && !event.altKey) {
            try {
              sessionStorage.setItem('hutba.feedbackReturn', JSON.stringify({
                url: window.location.href, x: window.scrollX, y: window.scrollY, time: Date.now(), restore: false
              }));
            } catch (e) {}
          }
        });
      })();
    </script>}
    <slot name="head" />
  </head>
  <body class:list={["min-h-screen bg-background text-foreground", { "reading-page": readingPage }]}>
    <header class="sticky top-0 z-40 border-b bg-background/80 dark:bg-[#181818] backdrop-blur supports-[backdrop-filter]:bg-background/60 supports-[backdrop-filter]:dark:bg-[#181818]/95">
      <NavBar client:load currentPath={Astro.url.pathname} />
    </header>
    <main class:list={["mx-auto w-full max-w-7xl py-6", readingPage ? "mobile-reading px-2 md:px-4" : "px-4"]}>
      <slot />
    </main>
    <GlossaryOverlay client:idle />
    <ScrollToTop client:load />
  </body>
</html>
