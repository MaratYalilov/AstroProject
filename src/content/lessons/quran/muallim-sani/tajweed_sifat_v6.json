{
  "properties": [
    {
      "name_ru": "Джахр",
      "name_ar": "الجهر",
      "lang_meaning": "громкость, звучность",
      "definition": "Задержка воздуха во время произношения буквы. Наличие вибрации голосовых связок при произношении звука. Противоположность – хамс."
    },
    {
      "name_ru": "Хамс",
      "name_ar": "الهمس",
      "lang_meaning": "шёпот, тихое звучание",
      "definition": "Продлевание движения воздуха без задержки во время произношения буквы из-за слабого давления на место выхода. При этом голосовые связки открыты. Противоположность – джахр."
    },
    {
      "name_ru": "Шидда",
      "name_ar": "الشدة",
      "lang_meaning": "сила, твёрдость",
      "definition": "Полная задержка звука во время произношения буквы из-за полноты силы давления, затем резкое раскрытие смычки. Противоположность – рахава."
    },
    {
      "name_ru": "Рахава",
      "name_ar": "الرخاوة",
      "lang_meaning": "мягкость, слабость",
      "definition": "Неполное преграждение воздуха, продлевание звука из-за слабого давления на место выхода. Противоположность – шидда."
    },
    {
      "name_ru": "Байния",
      "name_ar": "البينية",
      "lang_meaning": "промежуточность, нахождение между двумя состояниями",
      "definition": "Частичное продлевание звука из-за среднего давления на месте выхода. Присутствует частичная задержка звука. Промежуточное качество между шиддой и рахава."
    },
    {
      "name_ru": "Истифаль",
      "name_ar": "الاستفال",
      "lang_meaning": "понижение, опускание",
      "definition": "Опускание корня языка к дну ротовой полости. Признак «плоских» (неэмфатических) букв, произносимых с низким резонансом."
    },
    {
      "name_ru": "Исти`ля",
      "name_ar": "الاستعلاء",
      "lang_meaning": "возвышение, подъём",
      "definition": "Приподнятие задней части языка к твёрдому нёбу, язык заполняет ротовую полость. Признак эмфатических («тяжёлых») букв (ص, ض, ط, ظ, غ, خ, ق)."
    },
    {
      "name_ru": "Инфитах",
      "name_ar": "الانفتاح",
      "lang_meaning": "открытость",
      "definition": "Оставление звука в широком пространстве из-за отсутствия подъема большей части языка. Отдаленность языка от верхнего нёба. Присущ большинству букв арабского алфавита."
    },
    {
      "name_ru": "Итбак",
      "name_ar": "الإطباق",
      "lang_meaning": "смыкание, прижатие",
      "definition": "Оставление звука между нёбом и языком в узком пространстве из-за подъёма большей части языка (прижатие средней или задней части языка к твёрдому нёбу). Противоположность – инфитах."
    },
    {
      "name_ru": "Изляк",
      "name_ar": "الإذلاق",
      "lang_meaning": "беглость, лёгкость произношения",
      "definition": "Свойство букв, которые произносятся кончиком языка (ر، ل، ن) или губами (ف، ب، م) – «беглые». Противоположность – исмат."
    },
    {
      "name_ru": "Исмат",
      "name_ar": "الإصمات",
      "lang_meaning": "сдержанность, затруднённость",
      "definition": "Затруднённость (скованность) произношения. Все буквы, не входящие в группу изляк; их произнесение требует большей артикуляционной стабильности."
    },
    {
      "name_ru": "Сафир",
      "name_ar": "الصفير",
      "lang_meaning": "свист",
      "definition": "Свистящий призвук. Характерен для трёх букв: ص, ز, س (проходят через узкую щель между передними зубами и языком, создавая свист)."
    },
    {
      "name_ru": "Калькаля",
      "name_ar": "القلقلة",
      "lang_meaning": "сотрясение, колебание",
      "definition": "Колебание звука букв калькаля (взрывная вибрация) при их произношении с сукуном, с отдалением органов речи друг от друга, без добавления огласовки."
    },
    {
      "name_ru": "Лин",
      "name_ar": "اللين",
      "lang_meaning": "мягкость",
      "definition": "Мягкость (лёгкость произнесения). Качество букв و и ي с сукуном, перед которыми стоит звук с фатхой; произносятся мягко и плавно."
    },
    {
      "name_ru": "Гунна",
      "name_ar": "الغنة",
      "lang_meaning": "носовое звучание",
      "definition": "Звук, исходящий из носовой полости."
    },
    {
      "name_ru": "Тафашши",
      "name_ar": "التفشي",
      "lang_meaning": "распространение",
      "definition": "Распространение звука в ротовой полости во время произношения. Струя воздуха распространяется по ротовой полости и ударяется о зубы."
    },
    {
      "name_ru": "Такрир",
      "name_ar": "التكرير",
      "lang_meaning": "повторение",
      "definition": "Повторение звука более одного раза вследствие дрожания кончика языка. Следует сторониться. Качество буквы ر (ра). При правильном произношении следует избегать многократного вибрирования (один чёткий удар)."
    },
    {
      "name_ru": "Инхираф",
      "name_ar": "الانحراف",
      "lang_meaning": "отклонение",
      "definition": "Отклонение звука от своего места выхода к другому месту выхода по причине закрытия языком пути."
    },
    {
      "name_ru": "Иститаля",
      "name_ar": "الاستطالة",
      "lang_meaning": "удлинение, протяжённость",
      "definition": "Движение языка под воздействием сжатого воздуха между нёбом и языком. Исключительное свойство буквы ض: звук тянется от начала боковых зубов до конца выхода воздуха, требуя продолжительной артикуляции."
    }
  ],
