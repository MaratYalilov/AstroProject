---
import { getSocialImagePath } from "../utils/socialImage";

interface Props {
  title: string;
  subtitle?: string;
  subject?: string;
  image?: string;
  alt?: string;
}

const { title, subtitle, subject, image, alt = title } = Astro.props;
const imageUrl = new URL(image || getSocialImagePath(title, subtitle, subject), Astro.site ?? Astro.url).href;
---

<meta property="og:image" content={imageUrl} />
<meta property="og:image:alt" content={alt} />
{!image && <meta property="og:image:type" content="image/png" />}
{!image && <meta property="og:image:width" content="1200" />}
{!image && <meta property="og:image:height" content="630" />}
