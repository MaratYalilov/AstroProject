---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import CourseLayout from "./CourseLayout";
import { loadAllInteractiveLessons } from "../../lib/interactive/loadInteractiveLesson";
import { prepareInteractiveLesson } from "../../lib/interactive/prepareInteractiveLesson";
import { buildPageTitle, buildCourseDescription, buildInteractiveLessonMetadata } from "../../utils/pageMetadata";

interface Props {
  subject: string;
  course: string;
}

const { subject, course } = Astro.props;
const subjectEntry = (await getCollection("subjects")).find(entry => entry.data.slug === subject);
const courseEntry = (await getCollection("courses")).find(entry =>
  entry.data.subject === subject && entry.data.slug === course,
);
if (!subjectEntry || !courseEntry || courseEntry.data.type !== "interactive") {
  throw new Error(`Интерактивный курс не найден: ${subject}/${course}`);
}

const sourceLessons = await loadAllInteractiveLessons(subject, course);
const lessonSlug = Astro.url.searchParams.get("lesson");
const resumeLessons = sourceLessons.map(({ id, slug }) => ({ id, slug }));
const initialIndex = Math.max(0, sourceLessons.findIndex(lesson => lesson.slug === lessonSlug));
const lessons = await Promise.all(sourceLessons.map((lesson, index) =>
  index === initialIndex ? prepareInteractiveLesson(lesson) : lesson,
));
const selectedLesson = lessons.find(lesson => lesson.slug === lessonSlug);
const courseTitle = courseEntry.data.title;
const lessonMetadata = selectedLesson
  ? buildInteractiveLessonMetadata(selectedLesson, courseTitle, subjectEntry.data.title)
  : null;
const previewTitle = lessonMetadata?.ogTitle ?? [subjectEntry.data.title, courseTitle]
  .filter(Boolean)
  .join(" - ");
const pageTitle = lessonMetadata?.title ?? buildPageTitle(courseTitle, subjectEntry.data.title);
const description = lessonMetadata?.description ?? buildCourseDescription(courseTitle, courseEntry.data.description);
const canonicalPath = selectedLesson
  ? `/${subject}/${course}/?lesson=${encodeURIComponent(selectedLesson.slug)}`
  : `/${subject}/${course}`;
const canonical = new URL(canonicalPath, Astro.site).href;
---

<Base
  title={pageTitle}
  description={description}
  ogTitle={previewTitle}
  ogSubtitle={selectedLesson ? courseTitle : `${subjectEntry.data.title} · Курс`}
  ogSubject={subject}
  ogImage={selectedLesson?.ogImage ?? courseEntry.data.ogImage ?? subjectEntry.data.ogImage}
  readingPage
>
  <Fragment slot="head">
    {!lessonSlug && (
      <script define:vars={{ subject, course, resumeLessons }}>
        // Bare course URLs may be opened before the card's JavaScript is ready.
        // Resolve local progress before showing the default lesson.
        try {
          var key = 'course_progress_' + subject + '_' + course;
          var savedSlug = localStorage.getItem(key + '_slug');
          var index = resumeLessons.findIndex(function (lesson) { return lesson.slug === savedSlug; });
          if (index < 0) {
            index = parseInt(localStorage.getItem(key) || '', 10);
            if (Number.isInteger(index) && !savedSlug && subject === 'quran' && course === 'muallim-sani') {
              index = resumeLessons.findIndex(function (lesson) { return lesson.id === index; });
            }
          }
          if (Number.isInteger(index) && index > 0 && index < resumeLessons.length) {
            document.documentElement.setAttribute('data-course-resuming', '');
            var nextUrl = new URL(window.location.href);
            nextUrl.searchParams.set('lesson', resumeLessons[index].slug);
            window.location.replace(nextUrl.href);
          }
        } catch (e) {
          // With unavailable storage, keep the first server-rendered lesson.
        }
      </script>
    )}
    <link rel="canonical" href={canonical} />
  </Fragment>
  <CourseLayout
    client:load
    lessons={lessons}
    subject={subject}
    course={course}
    courseTitle={courseTitle}
    subjectTitle={subjectEntry.data.title}
    downloads={courseEntry.data.downloads}
    initialLessonSlug={selectedLesson?.slug}
  />
  <slot />
</Base>

<style is:global>
  html[data-course-resuming] [data-interactive-course] {
    visibility: hidden;
  }
</style>
