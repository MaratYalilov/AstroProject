---
interface Props {
  title: string;
  arabic: string;
  description: string;
  number: number;
  href?: string;
}
const { title, arabic, description, number, href } = Astro.props;
const Tag = href ? 'a' : 'div';
---
<Tag href={href} class:list={[
  'group relative flex h-full min-h-[180px] flex-col overflow-hidden rounded-xl border border-border/70 bg-gradient-to-br from-white to-gray-50/50 p-6 text-card-foreground shadow transition-all duration-300 dark:from-gray-900/50 dark:to-gray-800/30',
  href && 'interaction-card no-underline hover:-translate-y-1 hover:border-lime-300/50 hover:shadow-lg hover:shadow-lime-100/50 dark:hover:border-lime-800/50 dark:hover:shadow-lime-900/20',
]}>
  <div class="mb-4 flex items-start gap-4">
    <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-gray-100 to-gray-200 text-lg font-semibold dark:from-gray-800 dark:to-gray-700">{number}</span>
    <div class="min-w-0">
      <h2 class="text-lg font-semibold leading-tight text-gray-900 dark:text-gray-100">{title}</h2>
      <p lang="ar" dir="rtl" class="arab my-3 text-left">{arabic}</p>
      <p class="text-sm text-muted-foreground">{description}</p>
    </div>
  </div>
  <div class="mt-auto flex items-center justify-between gap-3 border-t border-border/60 pt-4 text-sm">
    <span>{href ? 'Открыть сборник' : 'Планируется'}</span>
    {href && <span aria-hidden="true">→</span>}
  </div>
</Tag>
