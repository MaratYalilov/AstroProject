---
import Base from '../../layouts/Base.astro';
import HadithCard from './HadithCard.astro';
import CollectionCard from './CollectionCard.astro';
import { collections, plannedCollections, indexes, normalize, collectionPath, recordPath, text } from '../../lib/hadith/collections';


// Decode after splitting so combined numbers such as 1697/1698a stay one segment.
const parts = Astro.url.pathname.replace(/^\/hadith-sbornik\/?/, '').split('/').filter(Boolean).map(part => {
  try { return decodeURIComponent(part); } catch { return part; }
});
const collection = collections.find(c => c.collection === parts[0]);
const root = parts.length === 0;
const index = collection && indexes.get(collection.collection)!;
const book = collection && parts[1] === 'book' && collection.books.find(b => String(b.id) === parts[2]);
const chapter = collection && parts[1] === 'chapter' && collection.chapters.find(c => c.id === parts[2]);
const numberMatch = parts.length === 2 ? /^(.+?)(?:-([2-9]\d*|1\d+))?$/.exec(parts[1]) : null;
const variants = collection && numberMatch ? collection.records.filter(r => r.hadith_numbers.some(n => String(n) === numberMatch[1])) : [];
const record = variants[Number(numberMatch?.[2] ?? 1) - 1];
const valid = root || !!collection && (parts.length === 1 || parts.length === 3 && !!(book || chapter) || !!record);
if (!valid) Astro.response.status = 404;
const q = (Astro.url.searchParams.get('q') ?? '').trim().slice(0, 200);
const jump = Astro.url.searchParams.get('number');
const jumpError = jump !== null && !index?.numbers.has(jump.trim());
const terms = normalize(q).split(/\s+/).filter(Boolean);
const filtered = collection && index ? (q ? index.search.filter(item => terms.every(term => item.value.includes(term)) || item.record.hadith_numbers.some(n => String(n) === q)).map(item => item.record) : collection.records)
  .filter(r => (!book || r.book_id === book.id) && (!chapter || r.chapter_id === chapter.id)) : [];
const pageCount = Math.max(1, Math.ceil(filtered.length / 20));
const rawPage = Number(Astro.url.searchParams.get('page') ?? 1);
const page = Math.min(pageCount, Math.max(1, Number.isFinite(rawPage) ? Math.floor(rawPage) : 1));
const pageHref = (n: number) => { const params = new URLSearchParams(); if (q) params.set('q', q); params.set('page', String(n)); return `${Astro.url.pathname}?${params}`; };
const bookForRecord = collection?.books.find(b => b.id === record?.book_id);
const chapterForRecord = collection?.chapters.find(c => c.id === record?.chapter_id);
const position = record ? collection!.records.indexOf(record) : -1;
const title = !valid ? 'Страница не найдена' : record ? `${collection!.title_ru} · Хадис № ${record.hadith_numbers.join(', ')}` : book ? text(book.title_ru) : chapter ? text(chapter.title_ru) : collection?.title_ru ?? 'Хадисы';
const showList = valid && collection && !record && (!!book || !!chapter || !!q);
const collectionHome = valid && collection && !book && !chapter && !record && !q;
const bookRanges = new Map<number, { first: string; last: string }>();
const compareNumbers = (a: string, b: string) => a.localeCompare(b, 'en', { numeric: true });
collection?.records.forEach(record => {
  const range = bookRanges.get(record.book_id);
  const numbers = record.hadith_numbers.map(String).sort(compareNumbers);
  const first = numbers[0];
  const last = numbers[numbers.length - 1];
  bookRanges.set(record.book_id, { first: range && compareNumbers(range.first, first) < 0 ? range.first : first, last: range && compareNumbers(range.last, last) > 0 ? range.last : last });
});
const counts = new Map<number, number>();
collection?.records.forEach(r => counts.set(r.book_id, (counts.get(r.book_id) ?? 0) + 1));
const chapterCounts = new Map<string | null, number>();
collection?.records.forEach(r => chapterCounts.set(r.chapter_id, (chapterCounts.get(r.chapter_id) ?? 0) + 1));
---
<Base title={`${title} | HUTBA`} description="Сборники хадисов: арабский текст, русский перевод, примечания, книги и главы.">
  <Fragment slot="head">
    <link rel="canonical" href={new URL(record ? recordPath(collection!, record) : Astro.url.pathname, Astro.site).href} />
    {(!valid || q || jumpError) && <meta name="robots" content="noindex,follow" />}
  </Fragment>
  <div class="mx-auto max-w-5xl space-y-6">
    <nav aria-label="Хлебные крошки" class="flex flex-wrap gap-2 text-sm text-muted-foreground">
      <a href="/">Главная</a><span>/</span><a href="/hadith-sbornik">Хадисы</a>
      {collection && <><span>/</span><a href={collectionPath(collection)}>{collection.title_ru}</a></>}
      {bookForRecord && <><span>/</span><a href={`${collectionPath(collection!)}/book/${bookForRecord.id}`}>{text(bookForRecord.title_ru)}</a></>}
    </nav>
    <header class:list={['space-y-3', collectionHome && 'collection-heading rounded-lg bg-muted/60 p-5']}>
      <div class:list={[collectionHome && 'collection-titles']}>
        <h1 class:list={[collectionHome ? 'text-xl font-medium md:text-2xl' : 'text-3xl font-bold md:text-4xl']}>{title}</h1>
        {collectionHome && <p lang="ar" dir="rtl" class="arab collection-arabic">{collection.title_ar}</p>}
      </div>
      {root && <p class="text-muted-foreground">Слова и наставления Пророка ﷺ. Выберите сборник для чтения.</p>}
      {collection && !record && !collectionHome && <p lang="ar" dir="rtl" class="arab text-left text-2xl leading-loose">{text(book ? book.title_ar : chapter ? chapter.title_ar : collection.title_ar)}</p>}
      {collectionHome && <>
        <p class="text-sm leading-relaxed text-muted-foreground">{collection.collection === 'bukhari' ? 'Сахих аль-Бухари - сборник хадисов имама Мухаммада аль-Бухари. Здесь представлены арабский текст, русский перевод и примечания. ' : 'Арабский текст, русский перевод и примечания. ' }Оглавление включает {collection.books.length} книг. Выберите книгу или найдите хадис по тексту и номеру.</p>
        <details class="collection-info text-sm">
          <summary class="cursor-pointer text-right text-muted-foreground underline-offset-4 hover:text-foreground hover:underline">Больше информации</summary>
          <div class="mt-3 space-y-2 border-t border-border pt-3 text-muted-foreground">
            <p>В этом корпусе {collection.records.length} записей и {collection.chapters.length} глав. Одна запись может объединять несколько номеров; для повторяющихся номеров доступны отдельные передачи.</p>
            <p>Источник перевода указан на странице каждого хадиса. Примечания и ссылки отображаются там, где они присутствуют в данных.</p>
          </div>
        </details>
      </>}
    </header>
    {!valid ? <p>Такой страницы нет. <a class="underline" href="/hadith-sbornik">Перейти к сборникам</a></p> : root ? <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {collections.map((c, i) => <CollectionCard href={collectionPath(c)} title={c.title_ru} arabic={c.title_ar} number={i + 1} description={`${c.books.length} книг · ${c.records.length} записей`} />)}
      {plannedCollections.map((c, i) => <CollectionCard title={c.title} arabic={c.arabic} number={collections.length + i + 1} description="Данные пока не добавлены" />)}
    </div> : collection && <>
      <section class="grid gap-5 rounded-xl border bg-muted/30 p-4 md:grid-cols-[2fr_1fr]" aria-label="Поиск и переход">
        <form action={record ? collectionPath(collection) : Astro.url.pathname} class="space-y-2">
          <label for="hadith-search" class="block text-sm font-medium">Поиск {book || chapter ? 'в этом разделе' : 'по сборнику'}</label>
          <div class="flex gap-2"><input id="hadith-search" name="q" value={q} maxlength="200" placeholder="Слово на русском или арабском" class="min-w-0 flex-1 rounded-lg border bg-background px-3 py-2" required /><button class="rounded-lg bg-primary px-4 py-2 text-primary-foreground">Найти</button></div>
        </form>
        <form action={collectionPath(collection)} class="space-y-2">
          <label for="hadith-number" class="block text-sm font-medium">Перейти к хадису №</label>
          <div class="flex gap-2"><input id="hadith-number" name="number" type="text" required placeholder={collection.collection === 'muslim' ? 'Например, 4a' : 'Например, 1'} class="min-w-0 flex-1 rounded-lg border bg-background px-3 py-2" /><button class="rounded-lg border bg-background px-4 py-2">Перейти</button></div>
        </form>
        {jumpError && <p role="alert" class="text-sm md:col-span-2">Хадис с таким номером не найден в этом сборнике. Проверьте номер.</p>}
      </section>
      <nav aria-label="Меню сборника" class="flex flex-wrap gap-4 text-sm underline"><a href="/hadith-sbornik">Все сборники</a><a href={collectionPath(collection)}>Все книги</a>{chapter && <a href={`${collectionPath(collection)}/book/${chapter.book_id}`}>К книге</a>}</nav>
      {record ? <>
        {chapterForRecord && <a class="block rounded-lg border p-4 hover:bg-muted" href={`${collectionPath(collection)}/chapter/${chapterForRecord.id}`}>{text(chapterForRecord.title_ru)} →</a>}
        <HadithCard collection={collection} record={record} full />
        {variants.length > 1 && <nav aria-label="Варианты передачи" class="flex flex-wrap gap-4 rounded-lg border p-4"><span class="text-sm text-muted-foreground">В этом корпусе несколько записей с номером {numberMatch![1]}:</span>{variants.map((variant, i) => <a class="text-sm underline" aria-current={variant === record ? 'page' : undefined} href={recordPath(collection, variant)}>Передача {i + 1}</a>)}</nav>}
        <nav aria-label="Соседние хадисы" class="flex justify-between gap-4">
          {position > 0 ? <a class="rounded-lg border p-3" rel="prev" href={recordPath(collection, collection.records[position - 1])}>← № {collection.records[position - 1].hadith_numbers.join(', ')}</a> : <span />}
          {position + 1 < collection.records.length && <a class="rounded-lg border p-3" rel="next" href={recordPath(collection, collection.records[position + 1])}>№ {collection.records[position + 1].hadith_numbers.join(', ')} →</a>}
        </nav>
      </> : <>
        {book && !q && <details class="rounded-xl border p-4" open><summary class="cursor-pointer font-semibold">Главы книги</summary><div class="mt-4 divide-y">{collection.chapters.filter(c => c.book_id === book.id).map(c => <a class="block py-3 hover:text-primary" href={`${collectionPath(collection)}/chapter/${c.id}`}>{text(c.title_ru) || text(c.title_ar)} <span class="text-sm text-muted-foreground">({chapterCounts.get(c.id) ?? 0})</span></a>)}</div></details>}
        {showList ? <>
          <p class="text-sm text-muted-foreground" role="status">{q ? `По запросу «${text(q)}» найдено записей` : 'Записей в разделе'}: {filtered.length}{filtered.length > 0 && ` · Страница ${page} из ${pageCount}`}</p>
          {filtered.length === 0 && <p>Ничего не найдено. Попробуйте другое слово или перейдите по номеру.</p>}
          <div class="space-y-4">{filtered.slice((page - 1) * 20, page * 20).map(r => <HadithCard collection={collection} record={r} />)}</div>
          {pageCount > 1 && <nav aria-label="Страницы результатов" class="flex items-center justify-between gap-3">{page > 1 ? <a class="rounded-lg border p-3" href={pageHref(page - 1)} rel="prev">← Назад</a> : <span />}<span>{page} / {pageCount}</span>{page < pageCount && <a class="rounded-lg border p-3" href={pageHref(page + 1)} rel="next">Далее →</a>}</nav>}
        </> : <section aria-label="Книги сборника" class="overflow-hidden rounded-xl border border-border bg-card/40">
          <div class="book-row border-b border-border bg-muted/60 px-4 py-3 text-xs font-medium text-muted-foreground md:px-5" aria-hidden="true">
            <span>№</span><span>Книга</span><span class="hidden text-right md:block">Название на арабском</span><span class="text-right">Хадисы</span>
          </div>
          <div class="book-list">
            {collection.books.map(b => {
              const range = bookRanges.get(b.id);
              return <a class="book-row group px-4 py-1 transition-colors focus-visible:outline focus-visible:outline-2 focus-visible:outline-gray-400 md:px-5" href={`${collectionPath(collection)}/book/${b.id}`}>
                <span class="book-number text-sm tabular-nums text-muted-foreground">{b.id}</span>
                <h2 class="book-title text-sm font-medium leading-tight md:text-base">{text(b.title_ru).replace(/^Книга\s*:\s*/i, '')}</h2>
                <p lang="ar" dir="rtl" class="arab book-arabic">{text(b.title_ar).replace(/^\d+\s*-\s*/, '')}</p>
                <span class="book-range text-right text-xs tabular-nums text-muted-foreground md:text-sm" aria-label={range ? `Хадисы с ${range.first} по ${range.last}` : 'Нет хадисов'}>{range ? `${range.first} - ${range.last}` : 'Нет записей'}</span>
              </a>;
            })}
          </div>
        </section>}
      </>}
    </>}
  </div>
</Base>

<style>
  .collection-heading { background: #f0f1f2; border: 1px solid #e1e3e5; border-radius: .5rem; padding: 1rem 1.25rem; }
  :global(.dark) .collection-heading { background: #34383b; border-color: #42464a; }
  .collection-titles { display: flex; flex-direction: row; flex-wrap: nowrap; align-items: center; justify-content: space-between; gap: 1.5rem; }
  .collection-titles h1 { margin: 0; padding: 0; border: 0; line-height: 1.3; }
  .collection-arabic { text-align: right; font-size: clamp(1.6rem, 4vw, 2rem); flex-shrink: 0; }
  .book-row { display: grid; grid-template-columns: 2rem minmax(0, 1fr) 6rem; gap: 0 1rem; align-items: center; }
  .book-list > .book-row { padding-top: 2px; padding-bottom: 2px; background: #fff; color: inherit; text-decoration: none; }
  .book-list > .book-row:hover { text-decoration: none; }
  .book-row > h2, .book-row > p { margin: 0; padding: 0; border: 0; color: inherit; }
  .book-list > .book-row:nth-child(even) { background: #eef0f2; }
  .book-list > .book-row:hover, .book-list > .book-row:focus-visible { background: #dce0e4; }
  :global(.dark) .book-list > .book-row { background: #292c2e; }
  :global(.dark) .book-list > .book-row:nth-child(even) { background: #35393c; }
  :global(.dark) .book-list > .book-row:hover, :global(.dark) .book-list > .book-row:focus-visible { background: #484e53; }
  .book-number { grid-column: 1; grid-row: 1 / 3; }
  .book-title { grid-column: 2; grid-row: 1; line-height: 1.2; }
  .book-arabic { grid-column: 2; grid-row: 2; text-align: right; font-size: 1.4rem; line-height: 1.35; }
  .book-range { grid-column: 3; grid-row: 1 / 3; }
  @media (min-width: 768px) {
    .book-row { grid-template-columns: 2rem minmax(0, 1fr) minmax(0, 1fr) 7rem; gap: 1.25rem; }
    .book-number, .book-title, .book-arabic, .book-range { grid-column: auto; grid-row: auto; }
    .book-arabic { font-size: 1.6rem; }
  }
  @media (prefers-reduced-motion: reduce) { .book-row { transition: none; } }
  @media (max-width: 420px) { .collection-titles { gap: .75rem; } .collection-titles h1 { font-size: 1rem; } .collection-arabic { font-size: 1.4rem; } }
</style>
