---
import { type Collection, type HadithRecord, recordPath, text } from '../../lib/hadith/collections';
import { referenceUrl } from '../../lib/hadith/references';
interface Props { collection: Collection; record: HadithRecord; full?: boolean }
const { collection, record, full = false } = Astro.props;
const gradingRu = [...new Set((record.grading?.ru ?? []).map(value => text(value).trim()).filter(Boolean))];
const gradingAr = [...new Set((record.grading?.ar ?? []).map(value => text(value).trim()).filter(Boolean))];
---
<article class="rounded-xl border bg-card p-5 md:p-8">
  <a class="font-semibold text-primary underline-offset-4 hover:underline" href={recordPath(collection, record)}>
    {collection.title_ru} · № {record.hadith_numbers.join(', ')}
  </a>
  {full ? <>
    <div lang="ar" dir="rtl" class="arab mt-6 whitespace-pre-line text-right text-2xl leading-loose md:text-3xl md:leading-loose">
      {record.arabic.parts.map(part => <span class:list={[part.kind === 'isnad' && 'text-muted-foreground']}>{text(part.text)}{' '}</span>)}
    </div>
    <h2 class="mt-8 text-lg font-semibold">Перевод</h2>
    <p class="mt-3 whitespace-pre-line text-lg leading-relaxed">{text(record.russian.full_text)}</p>
    {record.russian.source_id && <p class="mt-5 text-sm text-muted-foreground">Источник перевода: {collection.translation_sources[record.russian.source_id]?.title ?? record.russian.source_id}</p>}
    {record.russian.explanations?.length && <section class="mt-6 border-t pt-5" aria-label="Примечания">
      <h2 class="text-lg font-semibold">Примечания</h2>
      {record.russian.explanations.map(note => <div class="mt-4">
        <h3 class="font-medium">{text(note.title ?? 'Пояснение')}</h3>
        <p class="mt-2 whitespace-pre-line leading-relaxed">{text(note.text)}</p>
        {note.references?.map(referenceUrl).filter(Boolean).map((url, i) => <a class="mr-4 mt-2 inline-block text-sm underline" href={url} target={url.startsWith('/') ? undefined : '_blank'} rel="noopener noreferrer">Источник {i + 1}</a>)}
      </div>)}
    </section>}
  </> : <>
    <p class="mt-3 whitespace-pre-line leading-relaxed">{text(record.russian.full_text.slice(0, 360))}{record.russian.full_text.length > 360 ? '…' : ''}</p>
    <a class="mt-4 inline-block text-sm underline" href={recordPath(collection, record)}>Арабский текст, перевод и примечания →</a>
  </>}
  {(gradingRu.length > 0 || gradingAr.length > 0) && <section class="grading mt-5 border-t border-border pt-4" aria-label="Оценка достоверности">
    <h2 class="grading-title text-sm font-semibold">Оценка достоверности</h2>
    {gradingAr.map(value => <p lang="ar" dir="rtl" class="arab grading-arabic mt-2">{value}</p>)}
    {gradingRu.map(value => <p class:list={['grading-text mt-2 whitespace-pre-line text-sm leading-relaxed text-muted-foreground', !full && 'line-clamp-3']}>{full ? value : value.split(/\n\s*\n/)[0]}</p>)}
  </section>}
</article>

<style>
  .grading-title { margin: 0; padding: 0; border: 0; color: inherit; }
  .grading-arabic, .grading-text { margin-bottom: 0; }
  .arab > span {
    font-family: inherit;
    line-height: inherit;
  }
</style>
