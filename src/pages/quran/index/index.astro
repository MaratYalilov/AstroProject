---
import Base from '../../../layouts/Base.astro';
import { replaceQuranTags } from '../../../utils/replaceQuranTags';
import surahs from '../../../data/surahs.json';
import {
  reviewedIndex, finalAudit, normalizeSearch, noteMatches, sourceUrl, basisLabels,
} from '../../../utils/quranIndexReview';
import '../../../styles/quran-index.css';
import { localTafsir } from '../../../utils/quranIndexTafsirs';
import { localHadithSource } from '../../../utils/quranIndexHadith';

export const prerender = false;
const params = Astro.url.searchParams;
const queryText = (params.get('q') ?? '').trim().slice(0, 200);
const query = normalizeSearch(queryText);
const allTopics = reviewedIndex.topics;
const matchingTopics = allTopics.map((topic, index) => ({ topic, position: index + 1 })).filter(({ topic }) => {
  if (!query) return true;
  const title = normalizeSearch([topic.title, ...(topic.aliases ?? []), topic.scope_note ?? '', ...topic.see_also].join(' '));
  return (!/^\d+:\d+$/.test(query) && query.split(' ').every(word => title.includes(word))) || topic.items.some(item =>
    Object.entries(item.verse_notes).some(([key, note]) => noteMatches(query, topic, item, key, note)));
});
// Explicit topic links also work without a matching search query.
const requestedTafsirId = (params.get('tafsir') ?? '').slice(0, 160);
const requestedTafsir = localTafsir(requestedTafsirId);
const selected = allTopics.find(t => t.id === params.get('topic'))
  ?? (requestedTafsir ? allTopics.find(t => t.items.some(i => Object.values(i.verse_notes).some(n => n.source_ids.includes(requestedTafsirId)))) : undefined)
  ?? matchingTopics[0]?.topic;
const position = selected ? allTopics.indexOf(selected) + 1 : 0;
const rows = selected?.items.flatMap(item => Object.entries(item.verse_notes)
  .filter(([key, note]) => noteMatches(query, selected, item, key, note))
  .map(([key, note]) => ({ item, key, note }))) ?? [];
const total = rows.length;
const pageCount = Math.max(1, Math.ceil(total / 20));
const requestedPage = Number(params.get('page') ?? 1);
const page = Math.min(pageCount, Math.max(1, Number.isSafeInteger(requestedPage) ? requestedPage : 1));
const pageRows = rows.slice((page - 1) * 20, page * 20);
const path = '/quran/index';
function url(values: Record<string, string | number | undefined> = {}, anchor = 'index-results') {
  const next = new URLSearchParams({ ...(queryText ? { q: queryText } : {}), ...(selected ? { topic: selected.id } : {}) });
  if (page > 1) next.set('page', String(page));
  for (const [key, value] of Object.entries(values)) {
    if (value === undefined || value === '') next.delete(key); else next.set(key, String(value));
  }
  return `${path}?${next}#${anchor}`;
}
const requestedVerse = params.get('ayah') ?? '';
const [sura, ayah] = requestedVerse.split(':').map(Number);
const validVerse = /^\d{1,3}:\d{1,3}$/.test(requestedVerse) && surahs.some(s => s.num === sura && ayah >= 1 && ayah <= s.ayahs);
const verseHtml = validVerse ? replaceQuranTags(`{Quran}${sura}:${ayah}{/Quran}`) : '';
const numbers = new Intl.NumberFormat('ru');
const counts = finalAudit.counts;
const source = (id: string) => reviewedIndex.sources[id];
function sourceLink(id: string) {
  const ref = source(id);
  if (!ref) return undefined;
  const hadith = localHadithSource(id);
  if (hadith) return {
    title: hadith.status === 'pending_collection' ? `${ref.title} · сборник пока не подключён` : ref.title,
    href: hadith.status === 'available' ? hadith.url : undefined,
    external: false,
  };
  const local = localTafsir(id);
  return local ? { title: local.linkTitle, href: url({ tafsir: id }, 'selected-tafsir'), external: false }
    : { title: ref.title, href: sourceUrl(ref.url), external: true };
}
const related = selected ? finalAudit.crossreference_resolution.filter(r => r.from_topic_id === selected.id) : [];
---

<Base title="Проверенный тематический указатель Корана | HUTBA" description="Объединённый тематический указатель: аяты, объяснения тематических связей, источники и журнал исправлений.">
  <meta slot="head" name="robots" content="noindex, follow" />
  <div class="quran-index">
    <header class="qi-header">
      <p class="qi-eyebrow">Коран / Тематический указатель</p>
      <h1>Темы и аяты Корана</h1>
      <p class="qi-intro">Результаты проверки указателя: почему аят относится к теме и на чём основана связь.</p>
      <div class="qi-stats" aria-label="Итоги проверки">
        <span><strong>{counts.topics}</strong> тем</span>
        <span><strong>{numbers.format(counts.result)}</strong> связей</span>
        <span><strong>{numbers.format(counts.unique_verses)}</strong> разных аятов</span>
      </div>
      <details class="qi-about">
        <summary>О проверке и источниках</summary>
        <p>Арабский текст, перевод Кулиева и QCF взяты из локальных файлов сайта. Тафсиры и хадисы используются отдельно как основания толкования. Исторические версии и спорные отнесения отмечены в пояснениях.</p>
        <p>Тафсиры открываются здесь по локальным базам проекта «Аят»: сначала русский ас-Саади, если перевод доступен; иначе - арабский текст. Исходные толкования Ибн Касира, ат-Табари, аль-Куртуби, ас-Саади и аль-Багави также доступны.</p>
        <p>Хадисы ведут в локальные сборники аль-Бухари, Муслима и Абу Дауда с арабским текстом и русским переводом. Для ат-Тирмизи и Ибн Маджи пока показаны заглушки.</p>
        <p>Указатель помогает находить аяты по темам и проверять основания подборки. Он не исчерпывает все возможные тематические связи.</p>
        <a href="/quran/index/download.json" download>Скачать объединённый JSON</a>
      </details>
    </header>

    <form class="qi-search" method="get" action={path} role="search">
      <label for="index-query">Найти тему, слово или аят</label>
      <div class="qi-search-row">
        <input id="index-query" name="q" value={queryText} placeholder="Например: милость, Ибрахим или 2:255" maxlength="200" type="search" />
        <button type="submit">Найти</button>
        {queryText && <a class="qi-clear" href={path}>Сбросить</a>}
      </div>
      <p>Поиск по названиям, описаниям, пояснениям и ключевым цитатам. Адрес аята ищется точно.</p>
    </form>

    <div class="qi-workspace">
      <aside class="qi-sidebar">
        <details open>
          <summary>Темы <span>{matchingTopics.length} из {counts.topics}</span></summary>
          <nav aria-label="Темы указателя">
            {matchingTopics.map(({ topic, position: ordinal }) => <a
              href={url({ topic: topic.id, page: undefined, ayah: undefined })}
              aria-current={topic.id === selected?.id ? 'page' : undefined}>
              <span class="qi-ordinal">{ordinal}</span><span>{topic.title}</span>
            </a>)}
            {!matchingTopics.length && <p class="qi-muted">Тем не найдено. Попробуйте другое слово или сбросьте поиск.</p>}
          </nav>
        </details>
      </aside>
      <script is:inline>
        if (window.matchMedia('(max-width: 800px)').matches) {
          document.querySelector('.qi-sidebar details')?.removeAttribute('open');
        }
      </script>

      <section class="qi-content" id="index-results" aria-labelledby="qi-topic-title">
        {!selected ? <div class="qi-empty"><h2 id="qi-topic-title">Ничего не найдено</h2><p>Попробуйте более короткий запрос или адрес аята в формате 2:255.</p></div> : <>
          <header class="qi-topic-header">
            <p class="qi-eyebrow">Тема {position} из {counts.topics} <span class="qi-muted">/ {selected.id}</span></p>
            <h2 id="qi-topic-title">{selected.title}</h2>
            {!!selected.aliases?.length && <p class="qi-muted">Также: {selected.aliases.join(', ')}</p>}
            {selected.scope_note && <p class="qi-scope">{selected.scope_note}</p>}
            {!!related.length && <div class="qi-related">Смотрите также: {related.map(r => <a href={url({ topic: r.target_topic_id, q: undefined, page: undefined })}>{r.label}</a>)}</div>}
            {queryText && <p class="qi-muted">Показаны совпадения с «{queryText}». <a href={url({ q: undefined, page: undefined })}>Вся тема</a></p>}
          </header>

          {requestedVerse && <section class="qi-verse" id="selected-ayah" aria-label="Полный текст аята">
            <div class="qi-verse-heading"><h3>Аят {requestedVerse}</h3><a href={url({ ayah: undefined, tafsir: requestedTafsir ? requestedTafsirId : undefined }, requestedTafsir ? 'selected-tafsir' : 'index-results')}>Закрыть</a></div>
            {validVerse ? <div set:html={verseHtml} /> : <p>Такого адреса нет в локальном Коране. Проверьте номер суры и аята.</p>}
          </section>}

          {requestedTafsirId && <section class="qi-verse qi-tafsir" id="selected-tafsir" aria-label="Локальный текст тафсира">
            <div class="qi-verse-heading"><h3>{requestedTafsir?.readerTitle ?? 'Тафсир не найден'}</h3><a href={url({ ayah: requestedVerse || undefined }, requestedVerse ? 'selected-ayah' : 'index-results')}>Закрыть</a></div>
            {requestedTafsir ? <>
              <p class="qi-muted">Текст из локальной базы проекта «Аят».</p>
              {requestedTafsir.language === 'ru' && requestedTafsir.book !== 'sa3dy' && <p class="qi-muted">Русское толкование - ас-Саади. Исходное основание проверки - {requestedTafsir.title}; его арабский текст можно раскрыть ниже.</p>}
              {requestedTafsir.binding.was_english_abridgement && <p class="qi-muted">При проверке использовался сокращённый английский перевод Ибн Касира. Его арабский текст сохранён отдельно от русского ас-Саади.</p>}
              <a class="qi-tafsir-ayah" href={url({ ayah: `${requestedTafsir.sura}:${requestedTafsir.aya}`, tafsir: requestedTafsirId }, 'selected-ayah')}>Открыть аят {requestedTafsir.sura}:{requestedTafsir.aya}</a>
              {requestedTafsir.language === 'ru' ? <div>
                <section class="qi-tafsir-russian" lang="ru" aria-label="Тафсир ас-Саади на русском">
                  <h4>Ас-Саади · на русском</h4>
                  {requestedTafsir.russian.paragraphs.map(text => <p>{text}</p>)}
                </section>
                <details class="qi-tafsir-original">
                  <summary>{requestedTafsir.title} · арабский текст</summary>
                  <div class="qi-tafsir-text" lang="ar" dir="rtl">{requestedTafsir.paragraphs.map(text => <p class="arab">{text}</p>)}</div>
                </details>
              </div> : <section class="qi-tafsir-text" lang="ar" dir="rtl" aria-label="Тафсир на арабском">
                  <p class="qi-muted" lang="ru" dir="ltr">Для этого аята нет русского комментария в локальной базе. Открыт арабский текст.</p>
                  {requestedTafsir.paragraphs.map(text => <p class="arab">{text}</p>)}
                </section>}
            </> : <p>Для этой ссылки нет локальной записи тафсира.</p>}
          </section>}

          <p class="qi-result-count" aria-live="polite">Связей: {numbers.format(total)}{total > 20 && ` · Страница ${page} из ${pageCount}`}</p>
            {pageRows.map(row => <article class="qi-card">
              <div class="qi-card-heading"><h3>{row.item.description}</h3></div>
              <div class="qi-note-heading"><a class="qi-reference" href={url({ ayah: row.key }, 'selected-ayah')}>{row.key} <span>Открыть аят</span></a>
                <span class="qi-basis" title={reviewedIndex.basis_definitions[row.note.basis]}>{basisLabels[row.note.basis] ?? 'Основание указано ниже'}</span></div>
              <blockquote>«{row.note.key_phrase.text}»</blockquote>
              <p>{row.note.explanation}</p>
              {row.note.qualification && <p class="qi-qualification"><strong>Уточнение.</strong> {row.note.qualification}</p>}
              {row.note.usage_note && <p>{row.note.usage_note}</p>}
              {!!row.note.context_verse_keys?.length && <p class="qi-context">Контекст: {row.note.context_verse_keys.map(key => <a href={url({ ayah: key }, 'selected-ayah')}>{key}</a>)}</p>}
              <details class="qi-evidence"><summary>Основание и источники</summary>
                <p>{reviewedIndex.basis_definitions[row.note.basis]}</p>
                <p class="qi-muted">Цитата: перевод Кулиева, локальный текст сайта.</p>
                <ul class="qi-sources">{row.note.source_ids.filter(id => id !== 'site-quran').map(id => {
                  const ref = reviewedIndex.sources[id]; const link = sourceLink(id); return ref && link && <li>
                    {link.href ? <a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noopener noreferrer' : undefined}>{link.title}{link.external && ' ↗'}</a> : link.title}
                    {ref.hadith_grade && <span class="qi-muted"> · {ref.hadith_grade}</span>}
                  </li>;
                })}</ul>
              </details>
            </article>)}
            {!total && <p class="qi-empty">{selected.items.length ? 'Для выбранных условий связей не найдено.' : related.length ? 'Эта тема ведёт к другой теме указателя. Используйте ссылку выше.' : 'Подтверждённые связи с аятами не установлены.'}</p>}
            {pageCount > 1 && <nav class="qi-pagination" aria-label="Страницы связей">
              {page > 1 ? <a href={url({ page: page - 1 })}>← Назад</a> : <span />}
              <span>{page} / {pageCount}</span>
              {page < pageCount ? <a href={url({ page: page + 1 })}>Далее →</a> : <span />}
            </nav>}
        </>}
      </section>
    </div>
  </div>
</Base>
