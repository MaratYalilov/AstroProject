---
// src/pages/[subject]/[course].astro
import { replaceQuranTags } from "../../utils/replaceQuranTags";
import Base from "../../layouts/Base.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";
import LessonPage from "../../components/LessonPage";
import BlogLessonPage from "../../components/blog";
import InteractiveLessonPage from "../../components/alifba/InteractiveLessonPage";
import { experimental_AstroContainer } from "astro/container";
import { loadAllInteractiveLessons } from "../../lib/interactive/loadInteractiveLesson";
import fs from "node:fs";
import path from "node:path";

export async function getStaticPaths() {
  const courses = await getCollection("courses");

  return courses.map((c) => ({
    params: {
      subject: c.data.subject, // например "fiqh"
      course: c.data.slug,     // например "mishkat-namaz"
    },
  }));
}

const { subject, course } = Astro.params;

// 1) Предмет
const subjects = await getCollection("subjects");
const subjectEntry = subjects.find((s) => s.data.slug === subject);

if (!subjectEntry) {
  throw new Error(`Предмет не найден: ${subject}`);
}

// 2) Курс
const courseEntry = (await getCollection("courses")).find(
  (c) => c.data.subject === subject && c.data.slug === course
);

if (!courseEntry) {
  throw new Error(`Курс не найден: ${subject}/${course}`);
}

const courseTitle = courseEntry.data.title;
const layoutMode = courseEntry.data.layout ?? "tabs";
const isBlogLayout = layoutMode === "blog";

// Определяем, является ли курс интерактивным
const isInteractive = courseEntry.data.type === "interactive";

// 3) Уроки курса
const allLessons = (await getCollection("lessons"))
  .filter((l) => l.id.startsWith(`${subject}/${course}/`))
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const hasLessons = allLessons.length > 0;
const emptyStateMessage = "Для выбраного курса уроки ещё не загружены";

let currentLesson: {
  slug: string;
  title: string;
  order?: number;
  html: string;
  hasAudio?: boolean;
  hasVideo?: boolean;
  audio?: string | null;
  video?: string | null;
  vtt?: string | null;
} | null = null;

let lessons: {
  slug: string;
  title: string;
  order?: number;
  hasAudio?: boolean;
  hasVideo?: boolean;
}[] = [];

// ---------- INTERACTIVE: загружаем JSON уроки ----------
let interactiveLesson: any = null;
let interactiveLessons: any[] = [];

// AstroContainer нужен чтобы отрендерить MD в HTML строку
const astroContainer = await experimental_AstroContainer.create();

if (isInteractive) {
  // Загружаем все JSON уроки курса
  interactiveLessons = await loadAllInteractiveLessons(subject, course);

  // Берём первый урок как текущий
  interactiveLesson = interactiveLessons[0] ?? null;

  // Формируем список уроков для сайдбара
  lessons = interactiveLessons.map((l) => ({
    slug: `${subject}/${course}/${l.slug}`,
    title: l.title,
    order: l.id,
  }));

  // Формируем currentLesson для совместимости
  if (interactiveLesson) {
    currentLesson = {
      slug: `${subject}/${course}/${interactiveLesson.slug}`,
      title: interactiveLesson.title,
      order: interactiveLesson.id,
      html: "",
      audio: null,
      video: null,
      vtt: null,
      hasAudio: false,
      hasVideo: false,
    };
  }
} else if (hasLessons) {
  const current = allLessons[0];

  // Рендерим MD → HTML
  const { Content } = await render(current);
  const rawHtml = await astroContainer.renderToString(Content);
  const html = replaceQuranTags(rawHtml);

  const audioUrl = current.data.audioRel
    ? `/media/${subject}/${course}/${current.data.audioRel}`
    : current.data.audio ?? null;

  const videoUrl = current.data.videoRel
    ? `/media/${subject}/${course}/${current.data.videoRel}`
    : current.data.video ?? null;

  // Проверяем существование VTT файла на сервере
  let vttUrl: string | null = null;
  if (videoUrl) {
    try {
      const vttRelPath = videoUrl
        .replace("/video/", "/vtt/")
        .replace(/\.(mp4|webm|mov)$/i, ".vtt");
      const vttFsPath = path.join(process.cwd(), "public", vttRelPath);
      if (fs.existsSync(vttFsPath)) {
        vttUrl = vttRelPath;
      }
    } catch {
      vttUrl = null;
    }
  }

  currentLesson = {
    slug: current.id,
    title: current.data.title,
    order: current.data.order,
    hasAudio: Boolean(current.data.hasAudio ?? audioUrl),
    hasVideo: Boolean(current.data.hasVideo ?? videoUrl),
    audio: audioUrl,
    video: videoUrl,
    vtt: vttUrl,
    html,
  };

  lessons = allLessons.map((l) => ({
    slug: l.id,
    title: l.data.title,
    order: l.data.order,
    hasAudio: Boolean(l.data.hasAudio ?? l.data.audio ?? l.data.audioRel),
    hasVideo: Boolean(l.data.hasVideo ?? l.data.video ?? l.data.videoRel),
  }));
}
---

<Base title={`${subjectEntry.data.title} — ${courseTitle}`}>
  <Breadcrumbs
    items={[
      { label: "HUTBA", href: "/" },
      { label: subjectEntry.data.title, href: `/${subjectEntry.data.slug}/` },
      { label: courseTitle, href: `/${subject}/${course}` },
      {
        label:
          hasLessons && currentLesson
            ? currentLesson.title
            : "Урок не найден",
      },
    ]}
  />


{
  isInteractive && interactiveLesson ? (
    <InteractiveLessonPage
      client:load
      lesson={interactiveLesson}
      subject={subject}
      course={course}
    />
  ) : hasLessons && currentLesson ? (
    isBlogLayout ? (
      <BlogLessonPage
        client:load
        subject={subject}
        course={course}
        courseTitle={courseTitle}
        currentLesson={currentLesson}
        lessons={lessons}
      />
    ) : (
      <LessonPage
        client:load
        subject={subject}
        course={course}
        courseTitle={courseTitle}
        currentLesson={currentLesson}
        lessons={lessons}
      />
    )
  ) : (
    <section class="no-lessons-message">
      <p>{emptyStateMessage}</p>
    </section>
  )
}

</Base>