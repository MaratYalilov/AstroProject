---
// src/pages/lesson.astro
import { replaceQuranTags } from "../utils/replaceQuranTags";
import Base from "../layouts/Base.astro";
import BlogLessonPage from "../components/blog";
import InteractiveLessonPage from "../components/alifba/InteractiveLessonPage";
import LessonArticle from "../components/lesson/LessonArticle.astro";
import CourseProgram from "../components/lesson/CourseProgram";
import LessonCompleteButton from "../components/lesson/LessonCompleteButton";
import LessonPrevNext from "../components/lesson/LessonPrevNext.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getCollection, render } from "astro:content";
import { experimental_AstroContainer } from "astro/container";
import { replaceDicTags } from "../utils/replaceDicTags";
import { loadInteractiveLesson, loadAllInteractiveLessons } from "../lib/interactive/loadInteractiveLesson";
import fs from "node:fs";
import path from "node:path";
import { getLessonPreviewImage } from "../utils/lessonPreviewImage";
import { buildPageTitle, buildCourseDescription, buildLessonDescription } from "../utils/pageMetadata";
export const prerender = false;

// Читаем query-параметры
const url = Astro.url;
const subject = url.searchParams.get("subject") ?? "";
const course = url.searchParams.get("course") ?? "";
const slugParam = url.searchParams.get("slug") ?? "";

if (!subject || !course) {
  // Без обязательных параметров страница нечего показать. Раньше здесь
  // было исключение: /lesson отдавал пустую 500, и внешние проверки
  // получали NO_LCP. Ведём такого посетителя в каталог.
  return Astro.redirect("/", 302);
}

// ---------- 1) Предмет ----------
const subjects = await getCollection("subjects");
const subjectEntry = subjects.find((s) => s.data.slug === subject);

if (!subjectEntry) {
  throw new Error(`Предмет не найден: ${subject}`);
}

// ---------- 2) Курс ----------
const courses = await getCollection("courses");
const courseEntry = courses.find(
  (c) => c.data.subject === subject && c.data.slug === course
);

if (!courseEntry) {
  throw new Error(`Курс не найден: ${subject}/${course}`);
}

const courseTitle = courseEntry.data.title;

// Определяем, является ли курс интерактивным
const isInteractive = courseEntry.data.type === "interactive";

// ЖЁСТКО: для курса uchebnik-6-stolpov используем blog.tsx
const layoutMode = courseEntry.data.layout ?? "tabs";
const isBlogLayout = layoutMode === "blog";
const astroContainer = await experimental_AstroContainer.create();


// ---------- 3) Уроки курса ----------
const allLessons = await getCollection("lessons");
const lessonsCollection = allLessons.filter((l) =>
  l.id.startsWith(`${subject}/${course}/`)
);


const sortedLessons = lessonsCollection
  .slice()
  .sort((a, b) => (a.data.order ?? 999) - (b.data.order ?? 999));

const hasLessons = sortedLessons.length > 0;
const emptyStateMessage = "Для выбранного курса уроки ещё не загружены";

let currentLesson: any = null;
let lessons: any[] = [];
let lessonNotFound = false;
let ogImage = courseEntry.data.ogImage ?? subjectEntry.data.ogImage;

// ---------- INTERACTIVE: загружаем JSON уроки ----------
let interactiveLesson: any = null;
let interactiveLessons: any[] = [];

if (isInteractive) {
  const lessonSlug = slugParam.split("/").pop() || slugParam;

  // Загружаем все JSON уроки курса
  interactiveLessons = await loadAllInteractiveLessons(subject, course);

  // Ищем конкретный урок по slug. Явно указанный, но неизвестный slug
  // не подменяем первым уроком: отдаём 404 со ссылкой на курс.
  const matchedLesson = interactiveLessons.find((l) => l.slug === lessonSlug);
  lessonNotFound = Boolean(slugParam) && !matchedLesson;
  interactiveLesson = matchedLesson ?? interactiveLessons[0] ?? null;
  ogImage = interactiveLesson?.ogImage ?? ogImage;

  // Формируем список уроков для сайдбара (как в markdown версии)
  lessons = interactiveLessons.map((l) => ({
    slug: `${subject}/${course}/${l.slug}`,
    title: l.title,
    order: l.id,
  }));

  // Формируем currentLesson для совместимости с LessonPage (если нужно)
  if (interactiveLesson) {
    currentLesson = {
      slug: `${subject}/${course}/${interactiveLesson.slug}`,
      title: interactiveLesson.title,
      description: interactiveLesson.description,
      order: interactiveLesson.id,
      html: "", // interactive lessons не используют HTML
      audio: null,
      video: null,
      vtt: null,
      hasAudio: false,
      hasVideo: false,
    };
  }
} else if (hasLessons) {
  // slugParam может быть "157_predislovie" или полный slug "akida/uchebnik-6-stolpov/157_predislovie"
  const normalize = (s: string) => s.replace(/^\//, "");

  const normalizedSlug = normalize(slugParam);
  const matchedLesson = normalizedSlug
    ? sortedLessons.find((l) => {
        const full = normalize(l.id);
        const tail = full.split("/").pop();
        return full === normalizedSlug || tail === normalizedSlug;
      })
    : undefined;

  lessonNotFound = Boolean(normalizedSlug) && !matchedLesson;
  const target = matchedLesson ?? sortedLessons[0];

  // Рендерим MD → HTML
  const { Content } = await render(target);
  let rawHtml = await astroContainer.renderToString(Content);
  rawHtml = replaceQuranTags(rawHtml);
  const html = replaceDicTags(rawHtml);

  // Аудио / видео (если используешь audioRel / videoRel)
  const audioUrl = target.data.audioRel
    ? `/media/${subject}/${course}/${target.data.audioRel}`
    : target.data.audio ?? null;

  const videoUrl = target.data.videoRel
    ? `/media/${subject}/${course}/${target.data.videoRel}`
    : target.data.video ?? null;
  ogImage = getLessonPreviewImage(target.data.ogImage, videoUrl, ogImage);

  // Проверяем существование VTT файла на сервере и сразу формируем URL
  let vttUrl: string | null = null;
  if (videoUrl) {
    try {
      // Вычисляем путь к VTT из URL видео
      const vttRelPath = videoUrl
        .replace("/video/", "/vtt/")
        .replace(/\.(mp4|webm|mov)$/i, ".vtt");
      const vttFsPath = path.join(process.cwd(), "public", vttRelPath);
      if (fs.existsSync(vttFsPath)) {
        vttUrl = vttRelPath;
      }
    } catch {
      vttUrl = null;
    }
  }

  currentLesson = {
    slug: target.id,
    title: target.data.title,
    description: target.data.description,
    order: target.data.order,
    html,
    audio: audioUrl,
    video: videoUrl,
    vtt: vttUrl,
    hasAudio: Boolean(target.data.hasAudio ?? audioUrl),
    hasVideo: Boolean(target.data.hasVideo ?? videoUrl),
  };

  lessons = sortedLessons.map((l) => ({
    slug: l.id,
    title: l.data.title,
    order: l.data.order,
    group: l.data.group,
    groupOrder: l.data.groupOrder,
    hasAudio: Boolean(l.data.hasAudio ?? l.data.audio ?? l.data.audioRel),
    hasVideo: Boolean(l.data.hasVideo ?? l.data.video ?? l.data.videoRel),
  }));
}

const currentSlug = currentLesson?.slug ?? "";
const lessonIndex = lessons.findIndex((l) => l.slug === currentSlug);
const prevLesson = lessonIndex > 0 ? lessons[lessonIndex - 1] : null;
const nextLesson =
  lessonIndex >= 0 && lessonIndex < lessons.length - 1
    ? lessons[lessonIndex + 1]
    : null;
const buildLessonUrl = (slug: string) =>
  `/lesson?subject=${encodeURIComponent(subject)}&course=${encodeURIComponent(
    course,
  )}&slug=${encodeURIComponent(slug)}`;
const hasAnyMedia = Boolean(currentLesson?.video || currentLesson?.audio);
const hasBothMedia = Boolean(currentLesson?.video && currentLesson?.audio);
const programLessons = lessons.map(({ slug, title, order }) => ({
  slug,
  title,
  order,
}));
const pill =
  "inline-flex h-9 shrink-0 items-center justify-center gap-2 whitespace-nowrap rounded-full border border-primary/30 bg-primary/10 px-3 text-sm font-medium text-primary transition hover:bg-primary/20";

if (lessonNotFound) {
  Astro.response.status = 404;
}

const lessonTitle = Array.isArray(currentLesson?.title)
  ? currentLesson.title.map((part: { text: string }) => part.text).join("")
  : currentLesson?.title;
const previewTitle = lessonNotFound
  ? [subjectEntry.data.title, courseTitle].filter(Boolean).join(" - ")
  : [subjectEntry.data.title, courseTitle, lessonTitle]
      .filter(Boolean)
      .join(" - ");
const pageTitle = lessonNotFound
  ? buildPageTitle("Урок не найден", courseTitle)
  : buildPageTitle(lessonTitle, courseTitle);
const description = lessonNotFound
  ? buildCourseDescription(courseTitle, courseEntry.data.description)
  : lessonTitle
    ? buildLessonDescription(lessonTitle, courseTitle, currentLesson.description)
    : buildCourseDescription(courseTitle, courseEntry.data.description);
const canonicalPath = lessonNotFound
  ? `/${subject}/${course}`
  : isInteractive && interactiveLesson
    ? `/${subject}/${course}/?lesson=${encodeURIComponent(interactiveLesson.slug)}`
    : currentLesson
      ? `/lesson?subject=${encodeURIComponent(subject)}&course=${encodeURIComponent(course)}&slug=${encodeURIComponent(currentLesson.slug)}`
      : `/${subject}/${course}`;
const canonical = new URL(canonicalPath, Astro.site).href;

// Постер видео - элемент LCP на странице урока. Отдаём его preload с высоким
// приоритетом: <video poster> сам по себе грузится слишком поздно.
const posterUrl =
  !lessonNotFound && currentLesson?.video
    ? currentLesson.video
        .replace("/video/", "/thumbs/")
        .replace(/\.(mp4|webm|mov)$/i, ".jpg")
    : null;
---

<Base
  title={pageTitle}
  description={description}
  ogImage={ogImage}
  ogSubject={subject}
  ogTitle={previewTitle}
  ogSubtitle={courseTitle}
  readingPage
>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    {posterUrl && (
      <link rel="preload" as="image" href={posterUrl} fetchpriority="high" />
    )}
  </Fragment>
  <Breadcrumbs
    items={[
      { label: "HUTBA", href: "/" },
      { label: subjectEntry.data.title, href: `/${subjectEntry.data.slug}/` },
      { label: courseTitle, href: `/${subject}/${course}` },
      {
        label: lessonNotFound
          ? "Урок не найден"
          : hasLessons && currentLesson
            ? currentLesson.title
            : "Урок не найден",
      },
    ]}
  />

  {
    lessonNotFound ? (
      <section class="no-lessons-message mx-auto max-w-2xl py-10">
        <h1 class="mb-4 text-2xl font-semibold">Урок не найден</h1>
        <p class="mb-6 text-muted-foreground">
          Возможно, ссылка устарела или в адресе опечатка.
        </p>
        <a
          class="text-primary underline underline-offset-4 hover:opacity-80"
          href={`/${subject}/${course}`}
        >
          Открыть курс «{courseTitle}»
        </a>
        <script is:inline define:vars={{ subject, course, slugParam }}>
          // Если браузер помнит этот урок как последний, ссылка на курс
          // снова приведёт на тот же несуществующий slug. Чистим память.
          (function () {
            try {
              var key = 'last-lesson:' + subject + '/' + course;
              var stored = localStorage.getItem(key);
              if (!stored) return;
              var tail = stored.split('/').pop();
              if (stored === slugParam || tail === slugParam) {
                localStorage.removeItem(key);
              }
            } catch (e) {
              // Хранилище может быть недоступно.
            }
          })();
        </script>
      </section>
    ) : isInteractive && interactiveLesson ? (
      <>
        <h1 class="sr-only">{lessonTitle}</h1>
        <InteractiveLessonPage
          client:load
          lesson={interactiveLesson}
          subject={subject}
          course={course}
        />
      </>
    ) : hasLessons && currentLesson ? (
      isBlogLayout ? (
        <BlogLessonPage
          client:load
          subject={subject}
          course={course}
          courseTitle={courseTitle}
          currentLesson={currentLesson}
          lessons={lessons}
        />
      ) : (
        <div
          class="min-h-screen bg-background text-foreground"
          data-lesson-page="true"
          data-quran-audio-ready="true"
        >
          <main class="mx-auto w-full max-w-7xl px-0 py-0 lg:grid lg:grid-cols-12 lg:gap-6 lg:px-8 lg:py-6">
            <section class="lg:col-span-8">
              {currentLesson.video && (
                <div
                  id="lesson-video-wrap"
                  class="relative aspect-video w-full overflow-hidden bg-black lg:rounded-xl"
                >
                  <video
                    id="lesson-video"
                    class="h-full w-full"
                    controls
                    preload="none"
                    playsinline
                    poster={posterUrl ?? undefined}
                  >
                    <source src={currentLesson.video} />
                    {currentLesson.vtt && (
                      <track
                        kind="subtitles"
                        src={currentLesson.vtt}
                        srclang="ru"
                        label="Русский"
                        default
                      />
                    )}
                  </video>
                  <div class="lg:hidden">
                    <LessonPrevNext
                      subject={subject}
                      course={course}
                      prev={prevLesson}
                      next={nextLesson}
                      mode="video"
                    />
                  </div>
                </div>
              )}

              {currentLesson.audio && (
                <div
                  id="lesson-audio-wrap"
                  class="relative flex min-h-[140px] w-full flex-col rounded-xl border border-border/70 bg-muted/30 p-4 lg:min-h-0"
                  hidden={Boolean(currentLesson.video)}
                >
                  <div class="flex-grow"></div>
                  <audio
                    id="lesson-audio"
                    class="w-full"
                    controls
                    preload="none"
                    src={currentLesson.audio}
                  ></audio>
                  <div class="lg:hidden">
                    <LessonPrevNext
                      subject={subject}
                      course={course}
                      prev={prevLesson}
                      next={nextLesson}
                      mode="audio"
                    />
                  </div>
                </div>
              )}

              {!hasAnyMedia && (
                <div class="rounded-xl border border-border/70 bg-muted/30 p-6 text-sm text-muted-foreground">
                  Для этого урока видео и аудио отсутствует.
                </div>
              )}

              {/* Мобильный тулбар */}
              <div class="lg:hidden">
                <div class="border-x-0 border-t-0 border-border/70">
                  <div class="p-2">
                    <div class="relative w-full">
                      <div class="pointer-events-none absolute left-0 top-0 z-10 h-full w-6 bg-gradient-to-r from-background to-transparent"></div>
                      <div class="pointer-events-none absolute right-0 top-0 z-10 h-full w-6 bg-gradient-to-l from-background to-transparent"></div>
                      <div class="scrollbar-hide flex w-full gap-2 overflow-x-auto whitespace-nowrap px-1 pb-1">
                        {!hasAnyMedia && prevLesson && (
                          <a
                            href={buildLessonUrl(prevLesson.slug)}
                            class={pill}
                            aria-label={`Урок ${prevLesson.order ?? ""}`}
                          >
                            <span aria-hidden="true">‹</span>
                            {prevLesson.order != null && (
                              <span>{prevLesson.order} урок</span>
                            )}
                          </a>
                        )}
                        {hasBothMedia && (
                          <button
                            type="button"
                            class={`media-toggle ${pill}`}
                            data-label-audio="Аудио"
                            data-label-video="Видео"
                          >
                            {currentLesson.video ? "Аудио" : "Видео"}
                          </button>
                        )}
                        <a href="#course-program" class={pill}>
                          Программа
                        </a>
                        <LessonCompleteButton
                          client:idle
                          subject={subject}
                          course={course}
                          slug={currentLesson.slug}
                        />
                        {!hasAnyMedia && nextLesson && (
                          <a
                            href={buildLessonUrl(nextLesson.slug)}
                            class={pill}
                            aria-label={`Урок ${nextLesson.order ?? ""}`}
                          >
                            {nextLesson.order != null && (
                              <span>{nextLesson.order} урок</span>
                            )}
                            <span aria-hidden="true">›</span>
                          </a>
                        )}
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Десктопный тулбар */}
              <div class="hidden lg:block">
                <div class="border-0 shadow-none">
                  <div class="p-2 sm:p-4">
                    <div class="grid grid-cols-[1fr_auto_1fr] items-center gap-3">
                      <div class="flex justify-start"></div>
                      <div class="flex items-center justify-center gap-2">
                        {hasBothMedia && (
                          <button
                            type="button"
                            class={`media-toggle ${pill}`}
                            data-label-audio="Аудио-версия"
                            data-label-video="Видео-версия"
                          >
                            {currentLesson.video ? "Аудио-версия" : "Видео-версия"}
                          </button>
                        )}
                        {currentLesson.video && (
                          <a
                            href={currentLesson.video}
                            download
                            data-download="video"
                            class={pill}
                          >
                            Скачать
                          </a>
                        )}
                        {currentLesson.audio && (
                          <a
                            href={currentLesson.audio}
                            download
                            data-download="audio"
                            class={pill}
                            hidden={Boolean(currentLesson.video)}
                          >
                            Скачать
                          </a>
                        )}
                      </div>
                      <div class="flex justify-end gap-2">
                        <LessonCompleteButton
                          client:idle
                          subject={subject}
                          course={course}
                          slug={currentLesson.slug}
                        />
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              <LessonArticle
                html={currentLesson.html}
                title={String(lessonTitle ?? "")}
                subject={subject}
                course={course}
              />
            </section>

            <aside id="course-program" class="w-full lg:col-span-4">
              <div class="lg:sticky lg:top-[80px]">
                <CourseProgram
                  client:idle
                  subject={subject}
                  course={course}
                  currentSlug={currentLesson.slug}
                  lessons={programLessons}
                />
              </div>
            </aside>
          </main>

          <script is:inline>
            (function () {
              var toggles = document.querySelectorAll(".media-toggle");
              if (!toggles.length) return;
              var videoWrap = document.getElementById("lesson-video-wrap");
              var audioWrap = document.getElementById("lesson-audio-wrap");
              var mode = videoWrap ? "video" : "audio";

              function apply() {
                if (videoWrap) videoWrap.hidden = mode !== "video";
                if (audioWrap) audioWrap.hidden = mode !== "audio";
                toggles.forEach(function (button) {
                  button.textContent =
                    mode === "video"
                      ? button.getAttribute("data-label-audio")
                      : button.getAttribute("data-label-video");
                });
                document.querySelectorAll("[data-download]").forEach(function (link) {
                  link.hidden = link.getAttribute("data-download") !== mode;
                });
              }

              toggles.forEach(function (button) {
                button.addEventListener("click", function () {
                  mode = mode === "video" ? "audio" : "video";
                  apply();
                });
              });

              apply();

              document
                .querySelectorAll("#lesson-video, #lesson-audio")
                .forEach(function (media) {
                  var overlay = media.parentElement
                    ? media.parentElement.querySelector(".lesson-prevnext")
                    : null;
                  if (!overlay) return;
                  var hide = function () {
                    overlay.classList.add("opacity-0", "pointer-events-none");
                  };
                  var show = function () {
                    overlay.classList.remove("opacity-0", "pointer-events-none");
                  };
                  media.addEventListener("play", hide);
                  media.addEventListener("pause", show);
                  media.addEventListener("ended", show);
                });
            })();
          </script>

          <script is:inline define:vars={{ subject, course, slug: currentLesson.slug }}>
            (function () {
              try {
                var key = "last-lesson:" + subject + "/" + course;
                var params = new URLSearchParams(window.location.search);
                var last = window.localStorage.getItem(key);
                if (last && !params.get("slug")) {
                  window.location.replace(
                    "/lesson?subject=" +
                      encodeURIComponent(subject) +
                      "&course=" +
                      encodeURIComponent(course) +
                      "&slug=" +
                      encodeURIComponent(last),
                  );
                  return;
                }
                window.localStorage.setItem(key, slug);
                var recent = JSON.parse(
                  window.localStorage.getItem("recent-lessons") || "{}",
                );
                recent[key] = {
                  slug: slug,
                  subject: subject,
                  course: course,
                  title: document.title,
                  timestamp: Date.now(),
                };
                window.localStorage.setItem("recent-lessons", JSON.stringify(recent));
              } catch (error) {
                // Хранилище может быть недоступно.
              }
            })();
          </script>

          <script>
            import {
              getGlossaryLinkSlug,
              getGlossaryTarget,
            } from "../utils/glossaryTarget";

            function locateGlossaryTarget() {
              const slug = getGlossaryTarget(window.location.hash);
              const root = document.querySelector("main");
              if (!slug || !root) return;

              let observer: MutationObserver | undefined;
              let timer: number | undefined;
              let frame: number | undefined;
              let highlighted: HTMLAnchorElement | undefined;

              const stop = () => {
                observer?.disconnect();
                window.clearTimeout(timer);
                if (frame !== undefined) window.cancelAnimationFrame(frame);
                highlighted?.classList.remove("glossary-term-target");
              };

              const reveal = () => {
                const target = [
                  ...root.querySelectorAll<HTMLAnchorElement>("a[href]"),
                ].find((link) => {
                  if (
                    getGlossaryLinkSlug(
                      link.getAttribute("href")!,
                      window.location.origin,
                    ) !== slug
                  ) {
                    return false;
                  }
                  for (
                    let parent = link.parentElement;
                    parent;
                    parent = parent.parentElement
                  ) {
                    if (parent instanceof HTMLDetailsElement) parent.open = true;
                  }
                  return link.getClientRects().length > 0;
                });
                if (!target) return;
                if (
                  target === highlighted &&
                  target.classList.contains("glossary-term-target")
                ) {
                  return;
                }
                highlighted?.classList.remove("glossary-term-target");
                if (frame !== undefined) window.cancelAnimationFrame(frame);
                highlighted = target;
                target.classList.add("glossary-term-target");
                frame = window.requestAnimationFrame(() => {
                  target.scrollIntoView({ block: "center", behavior: "instant" });
                  target.focus({ preventScroll: true });
                });
              };

              observer = new MutationObserver(reveal);
              observer.observe(root, { childList: true, subtree: true });
              timer = window.setTimeout(() => observer?.disconnect(), 20_000);
              reveal();
            }

            locateGlossaryTarget();
            window.addEventListener("hashchange", locateGlossaryTarget);
          </script>

          <script is:inline>
            document.addEventListener("DOMContentLoaded", function () {
              document.dispatchEvent(new CustomEvent("quran:reinit"));
            });
          </script>
        </div>
      )
    ) : (
      <section class="no-lessons-message">
        <p>{emptyStateMessage}</p>
      </section>
    )
  }
</Base>
