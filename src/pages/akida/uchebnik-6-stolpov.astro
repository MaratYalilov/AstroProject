---
// Совместимость со старыми ссылками на курс. Карточка ведёт сразу на /lesson.
import { getCollection } from 'astro:content';
import OpenGraphImage from '../../components/OpenGraphImage.astro';
const subject = 'akida';
const course = 'uchebnik-6-stolpov';
const courseEntry = (await getCollection('courses')).find(c => c.data.subject === subject && c.data.slug === course);
const subjectEntry = (await getCollection('subjects')).find(s => s.data.slug === subject);
const ogImage = courseEntry?.data.ogImage ?? subjectEntry?.data.ogImage;
const firstLessonSlug = 'akida/uchebnik-6-stolpov/0-predislovie';
const fallbackUrl = `/lesson?subject=${encodeURIComponent(subject)}&course=${encodeURIComponent(course)}&slug=${encodeURIComponent(firstLessonSlug)}`;
---
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Учебник 6 столпов — открытие урока</title>
    <meta property="og:title" content="Учебник 6 столпов" />
    <meta property="og:site_name" content="HUTBA" />
    <OpenGraphImage title="Учебник 6 столпов" subject={subject} subtitle="Курс" image={ogImage} />
    <style is:inline>
      html { background: #fff; color: #09090b; color-scheme: light; }
      html[data-theme="dark"] { background: hsl(200 3% 17%); color: #fafafa; color-scheme: dark; }
      @media (prefers-color-scheme: dark) {
        html:not([data-theme]) { background: hsl(200 3% 17%); color: #fafafa; color-scheme: dark; }
      }
      body { margin: 0; font-family: sans-serif; }
      a { color: inherit; }
    </style>
    <!-- Выполняем сразу при разборе head, без загрузки отдельного JS-модуля. -->
    <script is:inline define:vars={{ subject, course, firstLessonSlug }}>
      (function () {
        var theme = null;
        var slug = firstLessonSlug;
        try {
          theme = localStorage.getItem('theme');
          slug = localStorage.getItem(`last-lesson:${subject}/${course}`) || firstLessonSlug;
        } catch (error) {
          // Хранилище может быть недоступно; остаётся первый урок.
        }
        var dark = theme
          ? theme === 'dark'
          : window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
        window.location.replace(`/lesson?subject=${encodeURIComponent(subject)}&course=${encodeURIComponent(course)}&slug=${encodeURIComponent(slug)}`);
      })();
    </script>
    <noscript>
      <meta http-equiv="refresh" content={`0;url=${fallbackUrl}`} />
    </noscript>
  </head>
  <body>
    <noscript><p><a href={fallbackUrl}>Перейти к уроку</a></p></noscript>
  </body>
</html>
