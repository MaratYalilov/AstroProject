---
import Base from '@/layouts/Base.astro'
import GlossaryPage from '@/components/glossary/GlossaryPage'
import { getCollection } from 'astro:content'
import { buildGlossaryEntryMetadata } from '@/utils/glossaryMetadata'
import { loadGlossaryLessonLinks } from '@/lib/glossary/loadGlossaryLessonLinks'
import { buildGlossarySummaries, buildGlossaryEntry } from '@/lib/glossary/glossaryPageData'
import { buildGlossaryStructuredData, serializeGlossaryStructuredData, GLOSSARY_SCHEMA_ID } from '@/utils/glossaryStructuredData'

export async function getStaticPaths() {
  const entries = await getCollection('glossary')

  return entries.map(e => ({
    params: { slug: e.data.url_slug ?? e.id },
  }))
}

const site = Astro.site
const { slug } = Astro.params

const entries = (await getCollection('glossary')).map(e => ({
  id: e.id,
  data: e.data,
  // body в новых версиях Astro — string | undefined
  body: e.body ?? '',
}))

const entry = entries.find(
  e => (e.data.url_slug ?? e.id) === slug
)

if (!entry) {
  return Astro.redirect('/glossary')
}

const canonical = new URL(`/glossary/${slug}`, site).toString()

const metadata = buildGlossaryEntryMetadata(entry.data)
const structuredData = buildGlossaryStructuredData(entries, site!, entry)
const lessonLinks = await loadGlossaryLessonLinks(entry.data.used_in)
---
<Base title={metadata.title} description={metadata.description} ogTitle={metadata.ogTitle} ogImage={entry.data.ogImage}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <script is:inline id={GLOSSARY_SCHEMA_ID} type="application/ld+json" set:html={serializeGlossaryStructuredData(structuredData)} />

    <meta property="og:type" content={metadata.ogType} />
    <meta property="og:url" content={canonical} />

    <meta name="robots" content="index, follow" />
  </Fragment>

  <GlossaryPage
    entries={buildGlossarySummaries(entries)}
    initialEntry={buildGlossaryEntry(entry)}
    lessonLinks={lessonLinks}
    initialSlug={slug}
    siteUrl={site!.href}
    client:load
  />
</Base>
