---
import Base from '@/layouts/Base.astro'
import GlossaryPage from '@/components/glossary/GlossaryPage'
import { getCollection } from 'astro:content'

export async function getStaticPaths() {
  const entries = await getCollection('glossary')

  return entries.map(e => ({
    params: { slug: e.data.url_slug ?? e.id },
  }))
}

const site = Astro.site
const { slug } = Astro.params

const entries = (await getCollection('glossary')).map(e => ({
  id: e.id,
  data: e.data,
  // body в новых версиях Astro — string | undefined
  body: e.body ?? '',
}))

const entry = entries.find(
  e => (e.data.url_slug ?? e.id) === slug
)

if (!entry) {
  return Astro.redirect('/glossary')
}

const canonical = new URL(`/glossary/${slug}`, site).toString()

const title = `${entry.data.term} — Глоссарий`
const description =
  entry.data.description ??
  `${entry.data.term} — термин и определение из глоссария`
---
<Base title={title} description={description} ogImage={entry.data.ogImage}>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonical} />

    <meta name="robots" content="index, follow" />
  </Fragment>

  <GlossaryPage
    entries={entries}
    initialSlug={slug}
    client:load
  />
</Base>
