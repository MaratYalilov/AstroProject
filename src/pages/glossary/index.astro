---
import Base from '@/layouts/Base.astro'
import GlossaryPage from '@/components/glossary/GlossaryPage'
import { getCollection } from 'astro:content'
import { glossaryIndexMetadata } from '@/utils/glossaryMetadata'
import { loadGlossaryLessonLinks } from '@/lib/glossary/loadGlossaryLessonLinks'
import { buildGlossaryStructuredData, serializeGlossaryStructuredData, GLOSSARY_SCHEMA_ID } from '@/utils/glossaryStructuredData'

const rawGlossary = await getCollection('glossary')
const glossary = rawGlossary.map(e => ({
  id: e.id,
  data: e.data,
  body: e.body ?? '',
}))
const canonical = new URL('/glossary', Astro.site).href
const structuredData = buildGlossaryStructuredData(glossary, Astro.site!)
const lessonLinks = await loadGlossaryLessonLinks(rawGlossary.flatMap(entry => entry.data.used_in))
---

<Base
  title={glossaryIndexMetadata.title}
  ogTitle={glossaryIndexMetadata.ogTitle}
  description={glossaryIndexMetadata.description}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <script is:inline id={GLOSSARY_SCHEMA_ID} type="application/ld+json" set:html={serializeGlossaryStructuredData(structuredData)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={glossaryIndexMetadata.ogType} />
  </Fragment>
  <GlossaryPage entries={glossary} lessonLinks={lessonLinks} siteUrl={Astro.site!.href} client:load />
</Base>
