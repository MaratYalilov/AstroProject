---
import Base from '@/layouts/Base.astro'
import GlossaryPage from '@/components/glossary/GlossaryPage'
import { getCollection } from 'astro:content'

const rawGlossary = await getCollection('glossary')
const glossary = rawGlossary.map(e => ({
  id: e.id,
  data: e.data,
  body: e.body ?? '',
}))
---

<Base title="Словарь терминов">
  <GlossaryPage entries={glossary} client:load />
</Base>
