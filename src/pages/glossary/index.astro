---
import Base from '@/layouts/Base.astro'
import GlossaryPage from '@/components/glossary/GlossaryPage'
import { getCollection } from 'astro:content'
import { glossaryIndexMetadata } from '@/utils/glossaryMetadata'
import { loadGlossaryLessonLinks } from '@/lib/glossary/loadGlossaryLessonLinks'

const rawGlossary = await getCollection('glossary')
const glossary = rawGlossary.map(e => ({
  id: e.id,
  data: e.data,
  body: e.body ?? '',
}))
const canonical = new URL('/glossary', Astro.site).href
const lessonLinks = await loadGlossaryLessonLinks(rawGlossary.flatMap(entry => entry.data.used_in))
---

<Base
  title={glossaryIndexMetadata.title}
  ogTitle={glossaryIndexMetadata.ogTitle}
  description={glossaryIndexMetadata.description}
>
  <Fragment slot="head">
    <link rel="canonical" href={canonical} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={glossaryIndexMetadata.ogType} />
  </Fragment>
  <GlossaryPage entries={glossary} lessonLinks={lessonLinks} client:load />
</Base>
