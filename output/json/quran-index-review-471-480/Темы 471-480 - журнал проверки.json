  "additions": [
    {
      "topic_id": "topic-0457",
      "item_id": "topic-0457-item-001",
      "verse_key": "2:246",
      "reason": "Знать сынов Исраила после Мусы просит своего пророка назначить царя для сражения; это вводит историю Талута, названного далее.",
      "source_ids": [
        "site-quran"
      ]
    },
    {
      "topic_id": "topic-0457",
      "item_id": "topic-0457-item-001",
      "verse_key": "2:247",
      "reason": "Пророк объявляет избрание Талута царём и объясняет его превосходство знаниями и статью вопреки возражениям о недостатке имущества.",
      "source_ids": [
        "site-quran"
      ]
    },
    {
      "topic_id": "topic-0457",
      "item_id": "topic-0457-item-001",
      "verse_key": "2:248",
      "reason": "Знамением царствия Талута станет доставленный ангелами сундук с умиротворением и наследием семей Мусы и Харуна.",
      "source_ids": [
        "site-quran"
      ]
    }
  ],
  "description_changes": [
    {
      "item_id": "topic-0451-item-001",
      "before": "о таджассусе",
      "after": "Запрет выслеживания скрытых недостатков друг друга",
      "reason": "Таджассус в данном аяте относится к поиску скрытых недостатков людей; не делается вывод обо всех возможных видах разведки и расследования."
    },
    {
      "item_id": "topic-0452-item-001",
      "before": "о тайаммуме",
      "after": "Тайаммум при отсутствии воды: обращение к чистой земле и протирание лица и рук",
      "reason": "Уточнены непосредственно названные в аятах действия без добавления спорных подробностей фикха."
    },
    {
      "item_id": "topic-0453-item-002",
      "before": "о тайном перешептывании",
      "after": "Тайные беседы: содержание, ответственность и злонамеренные переговоры",
      "reason": "Не всякая тайная беседа запрещена или происходит от дьявола: 4:114 и 58:9 прямо различают доброе и дурное содержание."
    },
    {
      "item_id": "topic-0454-item-001",
      "before": "хранение тайн",
      "after": "Разглашение доверенной тайны в семье Пророка",
      "reason": "Оставшийся аят содержит конкретный рассказ; не приписывается буквальное общее повеление хранить любые сведения в тайне."
    },
    {
      "item_id": "topic-0455-item-001",
      "before": "вознаграждение богобоязненных",
      "after": "Обещанные блага, защита и награда богобоязненным",
      "reason": "3:120 касается защиты от козней, а не только посмертного вознаграждения; другие ссылки прямо называют награду и Рай."
    },
    {
      "item_id": "topic-0457-item-001",
      "before": "история Талута (Саула)",
      "after": "Назначение Талута, испытание войска и победа над Джалутом",
      "reason": "К заключительной части рассказа добавлены непосредственно соответствующие начало и назначение царя в 2:246-248."
    },
    {
      "item_id": "topic-0458-item-001",
      "before": "о пользе тем, кто совершает на пути’ Аллаха хаджж и умру",
      "after": "Таматту: жертвоприношение, а при невозможности - десять дней поста",
      "reason": "Вместо общего утверждения о пользе хаджа и умры выделен конкретный предмет 2:196."
    },
    {
      "item_id": "topic-0459-item-001",
      "before": "о тасаттуре",
      "after": "Прикрытие наготы, подобающая одежда при молитве и дозволенное украшение",
      "reason": "Уточнены три разных предмета: назначение одежды, облачение при поклонении и недопустимость выдуманного запрета дозволенных украшений."
    }
  ],
  "topic_changes": [
