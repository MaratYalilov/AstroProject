  "additions": [
    {
      "topic_id": "topic-0001",
      "item_id": "topic-0001-item-002",
      "verse_key": "2:218",
      "reason": "В сообщении Ибн Исхака, приведённом Ибн Касиром, участники похода спрашивают о награде; с их надеждой связывается этот аят.",
      "source_ids": [
        "site-quran",
        "ik-2-218"
      ]
    },
    {
      "topic_id": "topic-0005",
      "item_id": "topic-0005-item-001",
      "verse_key": "3:114",
      "reason": "Продолжается характеристика праведных людей Писания из 3:113; по указанному толкованию к ним относится и Ибн Салам.",
      "source_ids": [
        "site-quran",
        "ik-3-113"
      ]
    },
    {
      "topic_id": "topic-0005",
      "item_id": "topic-0005-item-001",
      "verse_key": "3:115",
      "reason": "Обещание не отвергать добрые дела относится к той же похваленной группе; именная связь следует из толкования 3:113.",
      "source_ids": [
        "site-quran",
        "ik-3-113"
      ]
    },
    {
      "topic_id": "topic-0007",
      "item_id": "topic-0007-item-001",
      "verse_key": "17:90",
      "reason": "Начинает перечень требований курайшитов. В рассказе Ибн Исхака, приведённом Ибн Касиром, среди участников собрания назван Ибн Аби Умаййа.",
      "source_ids": [
        "site-quran",
        "ik-17-90"
      ]
    },
    {
      "topic_id": "topic-0008",
      "item_id": "topic-0008-item-001",
      "verse_key": "4:95",
      "reason": "Аль-Бухари передаёт, что после жалобы Ибн Умм Мактума на слепоту было ниспослано уточнение об имеющих физическое препятствие.",
      "source_ids": [
        "site-quran",
        "bukhari-4593"
      ]
    },
    {
      "topic_id": "topic-0010",
      "item_id": "topic-0010-item-002",
      "verse_key": "92:17",
      "reason": "Обещает удаление от Огня богобоязненному; Ибн Касир включает Абу Бакра в описанный здесь образ.",
      "source_ids": [
        "site-quran",
        "ik-92-21"
      ]
    },
    {
      "topic_id": "topic-0010",
      "item_id": "topic-0010-item-002",
      "verse_key": "92:18",
      "reason": "Уточняет, кому дано обещание: расходующему имущество ради очищения. В толковании эта черта относится и к Абу Бакру.",
      "source_ids": [
        "site-quran",
        "ik-92-21"
      ]
    }
  ],
