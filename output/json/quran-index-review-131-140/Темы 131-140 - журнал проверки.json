  "description_changes": [
    {
      "item_id": "topic-0126-item-001",
      "before": "доля голодного в пище",
      "after": "Пища для нуждающихся и осуждение отказа бедняку",
      "reason": "Не устанавливается единая числовая доля; описаны отказ хозяев сада и кормление на пути милосердия."
    },
    {
      "item_id": "topic-0129-item-002",
      "before": "невежество и дикость по отношению к дочерям в доисламском обществе",
      "after": "Осуждение презрения к рождению дочери и приписывания дочерей Аллаху",
      "reason": "Неприязнь к собственным дочерям и ложное приписывание Богу различены; не каждый соседний аят о неверующих относится именно к дочерям."
    },
    {
      "item_id": "topic-0129-item-004",
      "before": "определенные условия выдачи дочерей замуж",
      "after": "Условие брачного предложения Мусе в Мадьяне",
      "reason": "28:27 - конкретная история предложения, не универсальная обязательность восьмилетнего найма при каждом браке."
    },
    {
      "item_id": "topic-0129-item-005",
      "before": "предложение выдать своих (Лута) дочерей замуж за неверных во имя спасения гостей",
      "after": "Слова Лута о дочерях как призыв к дозволенному вместо нападения на гостей",
      "reason": "Собственные дочери и женщины общины имеют разные толкования; не устанавливается общее разрешение брака с неверующими."
    },
    {
      "item_id": "topic-0130-item-001",
      "before": "друзья, ставшие наследниками",
      "after": "Права связанных клятвенным союзом и история наследования по побратимству",
      "reason": "Союз и помощь не равны автоматическому наследованию любого друга; тафсир приводит развитие нормы и разногласия."
    },
    {
      "item_id": "topic-0130-item-002",
      "before": "наиболее достойный дружбы человек",
      "after": "Подпункт исключён",
      "reason": "Обе ссылки относятся к семье Юсуфа; заявленная сравнительная степень дружбы ими не подтверждена."
    },
    {
      "item_id": "topic-0132-item-001",
      "before": "дурной характер",
      "after": "Нравственная скверна, отвержение веры и образ бесплодной земли",
      "reason": "Дурной характер не тождествен неверию; буквальная плохая земля и её нравственная притча различены."
    },
    {
      "item_id": "topic-0132-item-003",
      "before": "запреты на дурные поступки и прегрешения",
      "after": "Запрещённое, греховное и исключение при необходимости",
      "reason": "2:219 осуждает опьянение и азартные игры, окончательный запрет отдельно5:90; исключение в пище сохраняется."
    },
    {
      "item_id": "topic-0132-item-005",
      "before": "отказ от дурных намерений",
      "after": "Дурные предположения, сомнения и самоуверенные представления",
      "reason": "Большинство ссылок о неправильных убеждениях и подозрениях, а не намерении совершить конкретный поступок."
    },
    {
      "item_id": "topic-0132-item-006",
      "before": "уподобление сквернословия и кощунства сгнившему дереву",
      "after": "Скверное слово как непрочное вырванное дерево",
      "reason": "Аят говорит об отсутствии прочности, а не о сгнившем дереве; тафсир относит образ к неверию и его дурным плодам."
    },
    {
      "item_id": "topic-0133-item-001",
      "before": "отделение духа от тела во сне",
      "after": "Взятие душ во сне и возвращение к бодрствованию",
      "reason": "Текст различает сон и смерть; точная физическая механика отделения от тела аятами не описана."
    },
    {
      "item_id": "topic-0133-item-002",
      "before": "отделение духа от тела и смерть",
      "after": "Смерть, взятие души и последующий исход",
      "reason": "Отделение души от тела не заявлено буквальным содержанием всех ссылок; здесь также агония, возвращение к Богу и обещанный удел."
    },
    {
      "item_id": "topic-0521-item-001",
      "before": "душевное спокойствие",
      "after": "Сдержанность, доброжелательность и чистота сердца",
      "reason": "Перечисленные нравственные качества не объявлены прямым обещанием психологического спокойствия каждому человеку."
    },
    {
      "item_id": "topic-0521-item-002",
      "before": "обретение душевного спокойствия (сакины)",
      "after": "Утешение сердца поминанием и ниспослание покоя (сакины)",
      "reason": "Не каждый аят использует термин сакина: поминание и смягчение сердца отличены от прямого ниспослания покоя48:18,26."
    },
    {
      "item_id": "topic-0521-item-003",
      "before": "поручить свою душу Аллаху и вести праведную жизнь",
      "after": "Вера, благочестие и терпеливая стойкость",
      "reason": "Оба аята описывают праведный образ жизни и стойкость, но не буквально передачу души Аллаху."
    }
  ],
