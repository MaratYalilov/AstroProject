      "item_id": "topic-0414-item-002",
      "verse_key": "4:35",
      "reason": "При опасении разлада предлагаются посредники из обеих семей, а желание примирения связано с помощью Аллаха.",
      "source_ids": [
        "site-quran"
      ]
    },
    {
      "topic_id": "topic-0535",
      "item_id": "topic-0535-item-001",
      "verse_key": "93:9",
      "reason": "Прямой запрет притеснять сироту дополняет требование доброго отношения к нему.",
      "source_ids": [
        "site-quran"
      ]
    }
  ],
  "description_changes": [
    {
      "item_id": "topic-0412-item-002",
      "before": "о священниках, которые придают Аллаху сотоварищей",
      "after": "Книжники, поддержавшие многобожников против верующих",
      "reason": "Осуждение конкретной поддержки и веры в джибта и тагута не превращено в утверждение обо всех людях Писания или всех религиозных служителях."
    },
    {
      "item_id": "topic-0413-item-001",
      "before": "неизбежность сглаза (дурного глаза)",
      "after": "Действительность сглаза и меры предосторожности",
      "reason": "Из действительности сглаза не следует его неизбежность для каждого человека или независимость от воли Аллаха."
    },
    {
      "item_id": "topic-0413-item-002",
      "before": "обращение к защите Аллаха от сглаза (дурного глаза) и клеветы",
      "after": "Обращение к защите Аллаха от сглаза и зла завистника",
      "reason": "Клевета в этих аятах не названа. Связь сглаза со злом завистника дана именно по тафсиру."
    },
    {
      "item_id": "topic-0414-item-002",
      "before": "главное условие согласия в семье",
      "after": "Примирение при супружеском разладе",
      "reason": "Мирное соглашение - конкретное средство разрешения неприязни, а не объявленное единственное условие семейного согласия."
    },
    {
      "item_id": "topic-0414-item-005",
      "before": "о сохранении семьи",
      "after": "Обеспечение семьи и умеренность в расходах",
      "reason": "Различены прямые обязанности в отношении родителей и детей и общие нормы расходов. Не каждый из аятов обещает сохранение брака."
    },
    {
      "item_id": "topic-0414-item-003",
      "before": "ответственность главы семьи",
      "after": "Забота о вере и поклонении семьи",
      "reason": "Увещевание обращено к верующим и семье в целом; не вводится неуказанное ограничение только мужчинами или одной административной ролью."
    },
    {
      "item_id": "topic-0414-item-006",
      "before": "подарки (выражение симпатии) для сохранения семьи",
      "after": "Материальная помощь родителям и родственникам",
      "reason": "Аяты говорят о расходах и правах родни, а не об обязательных подарках для выражения романтической симпатии."
    },
    {
      "item_id": "topic-0415-item-010",
      "before": "в груди одного человека не может быть двух сердец",
      "after": "О двух сердцах в одном теле",
      "reason": "Сохранена формулировка предмета аята; не добавляются отсутствующие в нём выводы о медицинских вмешательствах."
    },
    {
      "item_id": "topic-0535-item-002",
      "before": "важность внесения обязательной милостыни (закята) в пользу сирот",
      "after": "Помощь, пожертвования и кормление сирот",
      "reason": "Перечисленные аяты не делают само сиротство отдельной безусловной категорией получателей обязательного закята; раздача имущества и закят в 2:177 различены."
    },
    {
      "item_id": "topic-0535-item-003",
      "before": "важность справедливого обращения с взятыми в жены девушками-сиротами",
      "after": "Справедливость к осиротевшим девушкам при решении о браке",
      "reason": "Предписание не ограничено уже взятыми в жёны: оно касается прав девушек под опекой и намерений опекунов."
    },
    {
      "item_id": "topic-0535-item-004",
      "before": "возвращение сиротам их имущества о возвращении, при участии свидетелей, сиротам их собственности по достижении ими зрелости",
      "after": "Имущественные права сирот и передача им имущества после проверки зрелости",
      "reason": "Исправлен повтор в заголовке; только 4:6 прямо соединяет брачный возраст, зрелый разум и свидетелей передачи, остальные ссылки имеют иной объём."
    },
    {
      "item_id": "topic-0417-item-001",
      "before": "о неодобрении Аллахом сквернословия, особенно вслух",
      "after": "Публичное злословие и исключение для притеснённого",
      "reason": "Исключение прямо содержится в аяте и не должно исчезать в общей формулировке запрета."
    },
    {
      "item_id": "topic-0420-item-002",
      "before": "о подверженности сладострастию",
      "after": "Пренебрежение молитвой и потакание желаниям",
      "reason": "Сохранены обе прямо связанные черты осуждаемого поколения; желания не сужены только до сексуальных."
    }
  ],
  "topic_changes": [
    {
      "topic_id": "topic-0412",
      "before": "священники",
      "after": "Книжники и религиозные авторитеты",
      "reason": "Исходные ссылки относятся к получившим часть Писания, поддержавшим многобожников; тафсир связывает эпизод с иудейскими книжниками. Термин «священники» не должен создавать ложную христианскую идентификацию."
    },
    {
      "topic_id": "topic-0420",
      "before": "сладострастие",
      "after": "Потакание страстям",
      "reason": "Аят говорит о следовании страстям вообще; его смысл не ограничен половым сладострастием."
    }
  ],
