  "description_changes": [
    {
      "item_id": "topic-0392-item-002",
      "before": "о рухсате",
      "after": "Взаимное согласие при торговле",
      "reason": "Сохранён точный случай разрешения через согласие сторон; общие слова о снисходительности и посильности не выданы за правила испрашивания разрешения."
    },
    {
      "item_id": "topic-0394-item-001",
      "before": "о савеянах",
      "after": "Прямые упоминания сабиев",
      "reason": "Использовано название из локального перевода; определённая современная идентификация сообщества не приписывается аятам."
    },
    {
      "item_id": "topic-0395-item-001",
      "before": "аятЫ, связанные с Са'дом ибн Аби Ваккасом",
      "after": "Подтверждённые именные связи и контекст Саада ибн Аби Ваккаса",
      "reason": "Исправлено оформление; прямое сообщение о поводе ниспослания отличается от связи соседнего аята и параллели в тафсире."
    },
    {
      "item_id": "topic-0396-item-001",
      "before": "воздержание от просьб о садаке",
      "after": "Скромность и сдержанность нуждающихся",
      "reason": "Аят хвалит сдержанных бедных и не является запретом любой необходимой просьбы о помощи."
    },
    {
      "item_id": "topic-0396-item-002",
      "before": "вознаграждение за раздачу садаки",
      "after": "Награда за искреннюю милостыню и условия её сохранения",
      "reason": "В перечне есть обещание награды и противоположные примеры показухи, попрёков и корыстного недовольства расходами."
    },
    {
      "item_id": "topic-0396-item-003",
      "before": "не следует настаивать, прося садаку",
      "after": "Похвала ненастойчивому обращению за помощью",
      "reason": "В 2:273 описано похвальное качество нуждающихся, а не отдельная формула полного запрета просьб."
    },
    {
      "item_id": "topic-0396-item-005",
      "before": "о надменных лицемерах, насмехающихся над верующими, которые тратили на садаку то, что им далось огромным трудом",
      "after": "Претензии лицемеров при раздаче и насмешки над жертвующими",
      "reason": "9:58 описывает недовольство распределением, а 9:79 - унижение жертвующих, в том числе малым из добытого с трудом."
    },
    {
      "item_id": "topic-0396-item-006",
      "before": "о раздаче Пророком садаки бедным",
      "after": "Милостыня перед тайной беседой с Посланником",
      "reason": "58:12 велит верующим предварять беседу милостыней, а не описывает раздачу самим Пророком; 58:13 облегчает это предписание."
    },
    {
      "item_id": "topic-0396-item-007",
      "before": "преимущество скрытой раздачи садаки над публичной",
      "after": "Тайная и явная милостыня, преимущество сокрытия в 2:271",
      "reason": "Только 2:271 прямо сравнивает способы; другие ссылки одобряют расходы обоих видов, не объявляя каждый раз их иерархию."
    },
    {
      "item_id": "topic-0396-item-008",
      "before": "приношение садаки нуждающемуся",
      "after": "Прощение долга нуждающемуся как милостыня",
      "reason": "2:280 о должнике: сначала обязательная отсрочка, затем предпочтительность отказа от долга или его части."
    },
    {
      "item_id": "topic-0396-item-009",
      "before": "раздавая садаку, выбирать лучшее из даваемого",
      "after": "Давать благое, не выбирая дурное для подаяния",
      "reason": "Аят запрещает выбирать то, чего сам не принял бы, но не требует в этой формулировке всегда отдавать самое дорогое имущество."
    },
    {
      "item_id": "topic-0396-item-010",
      "before": "раздающий садаку не беднеет, а богатеет",
      "after": "Умножение пожертвований и возмещение расходов",
      "reason": "Не обещается автоматическое немедленное увеличение денежного остатка после каждой милостыни; сохранены точные обещания аятов."
    },
    {
      "item_id": "topic-0397-item-001",
      "before": "важность приветствия в ответ на приветствие",
      "after": "Не объявлять неверующим приветствующего миром",
      "reason": "4:94 о необходимости удостоверяться и не убивать ради добычи, а не о формуле ответного приветствия."
    },
    {
      "item_id": "topic-0397-item-003",
      "before": "приветствие (салям) как обязанность всякого человека и ключ к знакомству",
      "after": "Приветствие в истории Ибрахима и приветствие ангелов праведникам",
      "reason": "Перечисленные рассказы не устанавливают сами по себе обязанность каждого человека всегда начинать приветствие."
    },
    {
      "item_id": "topic-0399-item-001",
      "before": "аяты, связанные с Салманом ал-Фариси",
      "after": "Сообщение о Салмане и его прежних единоверцах в тафсире",
      "reason": "Отнесение аята к Салману отмечено как сообщение тафсира, а не как имя в тексте Корана или самостоятельно установленный сахих-повод."
    },
    {
      "item_id": "topic-0400-item-001",
      "before": "о самаритянине",
      "after": "Самири и поклонение тельцу",
      "reason": "Название персонажа не превращается в неподтверждённую этническую идентификацию."
    },
    {
      "item_id": "topic-0401-item-001",
      "before": "о покушении на самоубийство",
      "after": "Общий запрет неправомерного лишения жизни",
      "reason": "17:33 защищает охраняемую жизнь, но не выделяет отдельное описание покушения на самоубийство."
    }
  ],
